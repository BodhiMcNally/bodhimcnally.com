---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { projects, publications, presentations } from '@/data/research';

const sortedProjects = [...projects].sort((a, b) =>
  Number(b.selected) - Number(a.selected) ||
  (b.startYear ?? 0) - (a.startYear ?? 0),
);
const sortedPublications = [...publications].sort((a, b) =>
  Number(b.selected) - Number(a.selected) || b.year - a.year,
);
const sortedPresentations = [...presentations].sort((a, b) =>
  Number(b.selected) - Number(a.selected) ||
  new Date(b.date).getTime() - new Date(a.date).getTime(),
);
const hasOutputs = sortedPublications.length > 0 || sortedPresentations.length > 0;
---

<BaseLayout
  title="Research"
  description="Bodhi McNally’s developing research interests in academic urology, surgical outcomes and quantitative clinical research."
>
  <PageHeader
    eyebrow="Research"
    title="Treatment, surgery and recovery"
    introduction="My developing interests lie in academic urology, surgical outcomes and quantitative clinical research. I am especially drawn to questions that connect clinical decisions with what happens before, during and after treatment."
    folio="02"
  />

  <section class="section section--compact" aria-labelledby="themes-title">
    <div class="container">
      <h2 class="eyebrow" id="themes-title">Research themes</h2>
      <ol class="theme-list">
        <li>
          <span class="theme-list__number">01</span>
          <h3>Urological oncology</h3>
          <p>
            How can evidence support treatment selection in prostate and renal cancer while preserving clinical context and patient priorities?
          </p>
        </li>
        <li>
          <span class="theme-list__number">02</span>
          <h3>Outcomes & recovery</h3>
          <p>
            How should perioperative, functional and patient-reported outcomes be defined and followed after robotic and minimally invasive surgery?
          </p>
        </li>
        <li>
          <span class="theme-list__number">03</span>
          <h3>Clinical data in practice</h3>
          <p>
            When can real-world data and clinical prediction clarify variation in care—and when do limits in measurement make stronger claims unsafe?
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="approach-title">
    <div class="container section-grid">
      <h2 class="section-label">
        <span class="section-label__number">01</span>
        <span id="approach-title">Approach</span>
      </h2>
      <div class="section-copy">
        <p class="section-copy__lead">
          My background in data science is a method base, not the subject of the work.
        </p>
        <p>
          Across these areas, I am most interested in research that begins with a clinically useful question, defines exposures and outcomes carefully, and makes uncertainty visible. Sophisticated analysis cannot rescue a poorly formed question or weak measurement.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="current-research-title">
    <div class="container section-grid">
      <h2 class="section-label">
        <span class="section-label__number">02</span>
        <span id="current-research-title">Current activity</span>
      </h2>
      <div class="section-copy">
        <p class="section-copy__lead">
          I am a Surgical Research Scholar with RISE, where I have been matched to a surgical mentor and a research project aligned with urology.
        </p>
        <p>
          At this stage, the value is practical: learning how a team turns a clinically relevant question into feasible collaborative research and communicates its conclusions at the right level of certainty.
        </p>
      </div>
    </div>
  </section>

  {
    sortedProjects.length > 0 && (
      <section class="section" aria-labelledby="projects-title">
        <div class="container section-grid">
          <h2 class="section-label">
            <span class="section-label__number">03</span>
            <span id="projects-title">Projects</span>
          </h2>
          <ul class="output-list">
            {sortedProjects.map((project) => (
              <li>
                <div>
                  <p class="output-list__title">{project.title}</p>
                  <p class="output-list__meta">
                    {[project.researchArea, project.role, project.institution]
                      .filter(Boolean)
                      .join(' · ')}
                  </p>
                  <p>{project.shortDescription}</p>
                </div>
                <span class="badge">{project.status}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    hasOutputs && (
      <section class="section" aria-labelledby="outputs-title">
        <div class="container section-grid">
          <h2 class="section-label">
            <span class="section-label__number">{sortedProjects.length > 0 ? '04' : '03'}</span>
            <span id="outputs-title">Research outputs</span>
          </h2>

          <div>
            {sortedPublications.length > 0 && (
            <div class="output-group">
              <h3>Publications</h3>
              <ol class="output-list">
                {sortedPublications.map((publication) => (
                  <li>
                    <div>
                      <p class="output-list__title">{publication.title}</p>
                      <p class="output-list__meta">{publication.citation}</p>
                    </div>
                    <div class="output-list__links">
                      {publication.doi && (
                        <a href={`https://doi.org/${publication.doi}`}>DOI</a>
                      )}
                      {publication.pubmedUrl && (
                        <a href={publication.pubmedUrl}>PubMed</a>
                      )}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
            )}

            {sortedPresentations.length > 0 && (
            <div class="output-group">
              <h3>Presentations</h3>
              <ol class="output-list">
                {sortedPresentations.map((presentation) => (
                  <li>
                    <div>
                      <p class="output-list__title">{presentation.title}</p>
                      <p class="output-list__meta">
                        {presentation.presentationType} · {presentation.conference}
                      </p>
                    </div>
                    {presentation.link && <a href={presentation.link}>Details</a>}
                  </li>
                ))}
              </ol>
            </div>
            )}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
