---
import MarkdownText from '@/components/MarkdownText.astro';
import EditableCopy from '@/components/EditableCopy.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { projects, publications } from '@/data/research';

const sortedPublications = [...publications].sort((a, b) =>
  Number(b.selected) - Number(a.selected) || b.year - a.year,
);
const hasPublications = sortedPublications.length > 0;
const filterFor = (publicationType: (typeof publications)[number]['publicationType']) =>
  publicationType === 'Conference abstract' ? 'abstracts' :
  publicationType === 'Other' ? 'other' : 'articles';
---

<BaseLayout
  title="Research"
  description="Bodhi McNally’s developing research interests in academic urology, surgical outcomes and quantitative clinical research."
>
  <PageHeader title="Research" cmsTitle="copy-74ca513267f4d243" />

  <section class="research-overview container" aria-labelledby="research-interests-title">
    <div class="research-overview__introduction">
      <EditableCopy copyId="copy-73a8b48b5df7f012" as="h2" id="research-interests-title" />
      <EditableCopy copyId="copy-6d73fc181fa73bbd" as="p" />
    </div>
  </section>

  <section class="current-research" aria-labelledby="current-research-title">
    <div class="container">
      <header class="section-heading">
        <EditableCopy copyId="copy-e88e596b062b24d7" as="p" class="eyebrow" />
        <EditableCopy copyId="copy-85193cee5ea7d17b" as="h2" id="current-research-title" />
      </header>

      <div class="research-projects">
        {
          projects.map((project) => (
            <article class="research-project">
              <div class="research-project__meta">
                <span>{project.status}</span>
                {project.startYear && <span>{project.startYear}–present</span>}
              </div>
              <h3>{project.title}</h3>
              <p class="research-project__affiliation">
                {[project.role, project.institution].filter(Boolean).join(' · ')}
              </p>
              <MarkdownText text={project.shortDescription} />
              {project.collaborators?.length && (
                <p class="research-project__collaborators">
                  Collaborating with {project.collaborators.join(', ')}
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="publications-section" id="publications" aria-labelledby="publications-title">
    <div class="container">
      <header class="section-heading">
        <EditableCopy copyId="copy-f8030c4b51fa352e" as="h2" id="publications-title" />
      </header>

      <div class="publication-tools" data-publication-tools>
        <div class="field publication-search">
          <EditableCopy copyId="copy-1c0925b176e8d110" as="label" for="publication-search" />
          <input
            id="publication-search"
            type="search"
            placeholder="Search by title, author, journal or year"
            autocomplete="off"
            disabled={!hasPublications}
            data-publication-search
          />
        </div>

        <div class="publication-filter" role="group" aria-label="Filter publications">
          <span>Show</span>
          <button type="button" aria-pressed="true" disabled={!hasPublications} data-publication-filter="all">All</button>
          <button type="button" aria-pressed="false" disabled={!hasPublications} data-publication-filter="articles">Articles</button>
          <button type="button" aria-pressed="false" disabled={!hasPublications} data-publication-filter="abstracts">Abstracts</button>
          <button type="button" aria-pressed="false" disabled={!hasPublications} data-publication-filter="selected">Selected</button>
        </div>

        <p class="publication-status" aria-live="polite" data-publication-status>
          {hasPublications ? `${sortedPublications.length} publications` : 'No publications listed'}
        </p>
      </div>

      <ol class="publication-list" data-publication-list>
        {
          sortedPublications.map((publication) => (
            <li
              data-publication
              data-type={filterFor(publication.publicationType)}
              data-selected={String(Boolean(publication.selected))}
              data-search={`${publication.title} ${publication.authors.join(' ')} ${publication.journal} ${publication.year} ${publication.citation}`.toLowerCase()}
            >
              <div>
                <p class="publication-list__type">{publication.publicationType} · {publication.year}</p>
                <h3>{publication.title}</h3>
                <MarkdownText class="publication-list__citation" text={publication.citation} />
              </div>
              <div class="publication-list__links">
                {publication.doi && <a href={`https://doi.org/${publication.doi}`}>DOI</a>}
                {publication.pubmedUrl && <a href={publication.pubmedUrl}>PubMed</a>}
              </div>
            </li>
          ))
        }
      </ol>

      <p class="publication-empty" data-publication-empty data-visible={String(!hasPublications)}>
        {hasPublications ? 'No publications match this search.' : 'No publications are listed yet.'}
      </p>
    </div>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>('[data-publication-search]');
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-publication-filter]')];
    const items = [...document.querySelectorAll<HTMLElement>('[data-publication]')];
    const status = document.querySelector<HTMLElement>('[data-publication-status]');
    const empty = document.querySelector<HTMLElement>('[data-publication-empty]');
    let activeFilter = 'all';

    const applyPublicationFilters = () => {
      const query = search?.value.trim().toLowerCase() ?? '';
      let visible = 0;

      items.forEach((item) => {
        const matchesSearch = !query || (item.dataset.search ?? '').includes(query);
        const matchesType =
          activeFilter === 'all' ||
          item.dataset.type === activeFilter ||
          (activeFilter === 'selected' && item.dataset.selected === 'true');
        const matches = matchesSearch && matchesType;
        item.hidden = !matches;
        if (matches) visible += 1;
      });

      if (status) status.textContent = `${visible} ${visible === 1 ? 'publication' : 'publications'}`;
      if (empty && items.length > 0) empty.dataset.visible = String(visible === 0);
    };

    search?.addEventListener('input', applyPublicationFilters);
    filters.forEach((button) => {
      button.addEventListener('click', () => {
        activeFilter = button.dataset.publicationFilter ?? 'all';
        filters.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
        applyPublicationFilters();
      });
    });
  </script>
</BaseLayout>
