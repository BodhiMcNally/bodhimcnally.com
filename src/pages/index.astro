---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Portrait from '@/components/Portrait.astro';
import ProfileList from '@/components/ProfileList.astro';
import { site } from '@/data/site';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    url: site.canonicalUrl,
    jobTitle: site.currentRole,
    affiliation: {
      '@type': 'CollegeOrUniversity',
      name: site.institution,
      url: 'https://www.sydney.edu.au/',
    },
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: site.institution,
      url: 'https://www.sydney.edu.au/',
    },
    sameAs: site.profiles.map((profile) => profile.href),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.canonicalUrl,
    description: site.defaultDescription,
  },
];
---

<BaseLayout structuredData={structuredData}>
  <section class="home-hero container" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <p class="home-hero__descriptor">{site.descriptor}</p>
      <h1 id="home-title">Bodhi <br />McNally</h1>
      <p class="home-hero__intro">{site.introduction}</p>
      <div class="home-hero__links" aria-label="Explore the website">
        <a class="arrow-link" href="/research/">Research direction</a>
        <a class="arrow-link" href="/teaching/">Teaching</a>
        <a class="arrow-link" href="/about/">About me</a>
      </div>
    </div>
    <Portrait eager={true} />
  </section>

  <section class="section section--ink" aria-labelledby="focus-title">
    <div class="container section-grid">
      <h2 class="section-label">
        <span class="section-label__number">01</span>
        <span id="focus-title">Current focus</span>
      </h2>
      <div class="section-copy">
        <p class="home-focus-statement">
          I am interested in how clinical data can support better decisions around surgery—and in measuring recovery in ways that matter to patients.
        </p>
        <p>
          My quantitative background shapes how I approach questions of treatment selection, perioperative outcomes and functional recovery. As a Surgical Research Scholar with RISE, I am developing experience in collaborative surgical research aligned with urology.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--compact" aria-labelledby="work-title">
    <div class="container">
      <h2 class="eyebrow" id="work-title">Research and teaching</h2>
      <div class="editorial-feature-list">
        <article class="editorial-feature">
          <h3>Research</h3>
          <div class="editorial-feature__copy">
            <p>
              My interests are taking shape around urological oncology, robotic and minimally invasive surgery, and outcomes research. The common thread is methodological: clinically useful questions, carefully defined measures, transparent analysis and proportionate conclusions.
            </p>
            <a class="arrow-link" href="/research/">Explore my research direction</a>
          </div>
        </article>

        <article class="editorial-feature">
          <h3>Teaching & resources</h3>
          <div class="editorial-feature__copy">
            <p>
              I teach undergraduate data science and statistics as a Casual Academic at the University of Sydney. Teaching reinforces the same habits that good clinical research depends on: clear questions, reproducible work and precise interpretation.
            </p>
            <div class="inline-links">
              <a class="arrow-link" href="/teaching/">Teaching approach</a>
              <a class="arrow-link" href="/resources/">Browse teaching notes</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="profiles-title">
    <div class="container section-grid">
      <h2 class="section-label">
        <span class="section-label__number">02</span>
        <span id="profiles-title">Academic profiles</span>
      </h2>
      <ProfileList />
    </div>
  </section>
</BaseLayout>
