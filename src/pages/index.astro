---
import EditableCopy from '@/components/EditableCopy.astro';
import { getCollection, render } from 'astro:content';

import BaseLayout from '@/layouts/BaseLayout.astro';
import Portrait from '@/components/Portrait.astro';
import ProfileList from '@/components/ProfileList.astro';
import { site } from '@/data/site';

const updates = await getCollection('updates', ({ data }) => !data.draft);
const homepageUpdates = await Promise.all(
  updates
    .sort((a, b) => {
      if (a.data.sortOrder !== b.data.sortOrder) return b.data.sortOrder - a.data.sortOrder;
      return (b.data.published?.getTime() ?? 0) - (a.data.published?.getTime() ?? 0);
    })
    .slice(0, 6)
    .map(async (entry) => {
      const { Content } = await render(entry);
      return { entry, Content };
    }),
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    url: site.canonicalUrl,
    jobTitle: site.currentRole,
    affiliation: {
      '@type': 'CollegeOrUniversity',
      name: site.institution,
      url: 'https://www.sydney.edu.au/',
    },
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: site.institution,
      url: 'https://www.sydney.edu.au/',
    },
    sameAs: site.profiles.map((profile) => profile.href),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.canonicalUrl,
    description: site.defaultDescription,
  },
];
---

<BaseLayout structuredData={structuredData}>
  <section class="home-introduction container" aria-labelledby="home-title">
    <div class="home-introduction__copy">
      <EditableCopy copyId="copy-0bfd20e941259f93" as="h1" id="home-title" />
      <EditableCopy copyId="profile-introduction" as="p" class="home-introduction__lead" />
      <EditableCopy copyId="profile-researchSummary" as="p" class="home-introduction__research" />

      <nav class="home-directory" aria-label="Main links">
        <a href="/about/">
          <span>About me</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href={site.cv.driveHref} target="_blank" rel="noreferrer">
          <span>Curriculum vitae</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="/research/">
          <span>Current research</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href="/teaching/">
          <span>Teaching</span>
          <span aria-hidden="true">→</span>
        </a>
      </nav>
    </div>

    <Portrait eager={true} caption={false} />
  </section>

  <section class="student-prompt">
    <div class="container student-prompt__inner">
      <EditableCopy copyId="copy-fb83c254119c4940" as="p" />
      <EditableCopy copyId="copy-11d2400ff126b200" as="p" />
    </div>
  </section>

  <section class="home-updates container" aria-labelledby="updates-title">
    <a class="text-link" href="/posts/">All posts</a>
    <header class="home-updates__header">
      <div>
        <EditableCopy copyId="copy-45d980789e3ddd51" as="p" class="eyebrow" />
        <EditableCopy copyId="copy-dcc096d6e3437329" as="h2" id="updates-title" />
      </div>
      <div class="update-carousel__controls" aria-label="Post navigation">
        <button type="button" data-update-previous aria-controls="recent-posts">
          <span aria-hidden="true">←</span>
          <span class="visually-hidden">Previous post</span>
        </button>
        <p aria-live="polite" aria-atomic="true" data-update-status>
          1 of {homepageUpdates.length}
        </p>
        <button type="button" data-update-next aria-controls="recent-posts">
          <span aria-hidden="true">→</span>
          <span class="visually-hidden">Next post</span>
        </button>
      </div>
    </header>

    <div class="update-carousel" data-update-carousel>
    <ol class="update-stream" id="recent-posts" data-update-track>
      {
        homepageUpdates.map(({ entry, Content }, index) => (
          <li class="update-entry" data-update-slide data-update-index={index}>
            <div class="update-entry__meta">
              {entry.data.published && (
                <time datetime={entry.data.published.toISOString()}>
                  {formatDate(entry.data.published)}
                </time>
              )}
              <span>{entry.data.source === 'linkedin' ? 'LinkedIn' : 'Website'}</span>
            </div>

            <article class="update-entry__content">
              <h3>{entry.data.title}</h3>
              {entry.data.source === 'linkedin' && entry.data.linkedinEmbedUrl ? (
                <iframe
                  class="linkedin-embed"
                  src={entry.data.linkedinEmbedUrl}
                  title={`LinkedIn post: ${entry.data.title}`}
                  loading="lazy"
                  allowfullscreen
                />
              ) : entry.data.collapsed ? (
                <>
                  <p class="update-entry__summary">{entry.data.summary}</p>
                  <details class="update-entry__details">
                    <EditableCopy copyId="copy-5cd5fe316c1ede64" as="summary" />
                    <div class="update-entry__body">
                      <Content />
                    </div>
                  </details>
                </>
              ) : (
                <div class="update-entry__body">
                  <Content />
                </div>
              )}

              {entry.data.linkedinUrl && (
                <a
                  class="text-link update-entry__link"
                  href={entry.data.linkedinUrl}
                  target="_blank"
                  rel="noreferrer"
                >
                  View on LinkedIn
                </a>
              )}
            </article>
          </li>
        ))
      }
    </ol>
    </div>

    <div class="update-carousel__pagination" aria-label="Choose a post">
      {
        homepageUpdates.map(({ entry }, index) => (
          <button
            type="button"
            aria-label={`Show post ${index + 1}: ${entry.data.title}`}
            aria-pressed={index === 0 ? 'true' : 'false'}
            data-update-page={index}
          >
            <span aria-hidden="true"></span>
          </button>
        ))
      }
    </div>
  </section>

  <section class="home-profiles container" aria-labelledby="profiles-title">
    <EditableCopy copyId="copy-2add4e0a476e926f" as="h2" class="visually-hidden" id="profiles-title" />
    <ProfileList />
  </section>

  <script is:inline>
    const updateCarousel = document.querySelector('[data-update-carousel]');
    const updateSlides = Array.from(document.querySelectorAll('[data-update-slide]'));
    const updatePages = Array.from(document.querySelectorAll('[data-update-page]'));
    const updateStatus = document.querySelector('[data-update-status]');
    const previousUpdate = document.querySelector('[data-update-previous]');
    const nextUpdate = document.querySelector('[data-update-next]');

    const updateTrack = document.querySelector('[data-update-track]');

    if (updateCarousel && updateTrack && updateSlides.length > 0) {
      let activeUpdate = 0;

      const positionUpdateTrack = () => {
        const activeSlide = updateSlides[activeUpdate];
        updateTrack.style.transform = `translate3d(-${activeSlide.offsetLeft}px, 0, 0)`;
      };

      const showUpdate = (index) => {
        activeUpdate = (index + updateSlides.length) % updateSlides.length;
        positionUpdateTrack();

        updatePages.forEach((page, pageIndex) => {
          page.setAttribute('aria-pressed', String(pageIndex === activeUpdate));
        });
        updateSlides.forEach((slide, slideIndex) => {
          const isActive = slideIndex === activeUpdate;
          slide.toggleAttribute('inert', !isActive);
          slide.setAttribute('aria-hidden', String(!isActive));
        });
        if (updateStatus) updateStatus.textContent = `${activeUpdate + 1} of ${updateSlides.length}`;
      };

      previousUpdate?.addEventListener('click', () => showUpdate(activeUpdate - 1));
      nextUpdate?.addEventListener('click', () => showUpdate(activeUpdate + 1));
      updatePages.forEach((page, index) => page.addEventListener('click', () => showUpdate(index)));
      window.addEventListener('resize', positionUpdateTrack, { passive: true });
      showUpdate(0);
    }
  </script>
</BaseLayout>
