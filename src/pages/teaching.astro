---
import EditableCopy from '@/components/EditableCopy.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/data/site';

const universityProfile = site.profiles.find((profile) => profile.label === 'University teaching profile');
---

<BaseLayout
  title="Teaching"
  description="Bodhi McNally teaches undergraduate data science and statistics at the University of Sydney, with an emphasis on reasoning, interpretation and reproducibility."
>
  <PageHeader title="Teaching" cmsTitle="copy-a212baea553ebbcd" />

  <section class="teaching-introduction container">
    <EditableCopy copyId="copy-69d0b182adfe4ae7" as="p" />
    {universityProfile && <a class="arrow-link" href={universityProfile.href}>University teaching profile</a>}
  </section>

  <section class="reading-section" aria-labelledby="philosophy-title">
    <div class="reading-section__inner container">
      <EditableCopy copyId="copy-08d73641c15fca4e" as="h2" id="philosophy-title" />
      <div class="teaching-philosophy">
        <EditableCopy copyId="copy-119c3ccd5401f2b3" as="p" />

        <EditableCopy copyId="copy-d7ec9451ca4abf3a" as="p" />

        <EditableCopy copyId="copy-b8ef5f788c254e20" as="p" />

        <EditableCopy copyId="copy-b3f96489a8f5e178" as="p" />

        <EditableCopy copyId="copy-6521975e0b77de21" as="p" />

        <EditableCopy copyId="copy-523f39408748334e" as="p" />
      </div>
    </div>
  </section>

  <section class="document-section" aria-labelledby="portfolio-title">
    <div class="container">
      <div class="document-panel">
        <div>
          <EditableCopy copyId="copy-282ae82ed7eea509" as="h2" id="portfolio-title" />
          <EditableCopy copyId="copy-323ccd230512bbdb" as="p" />
        </div>
        <a class="button" href={site.teachingPortfolio.href} target="_blank" rel="noreferrer">View teaching portfolio</a>
      </div>
    </div>
  </section>

  <section class="student-resources-section" aria-labelledby="student-resources-title">
    <div class="container student-resources-section__inner">
      <div>
        <EditableCopy copyId="copy-52d991952e65dd8d" as="h2" id="student-resources-title" />
        <EditableCopy copyId="copy-52b383edeea99b2d" as="p" />
        <a class="arrow-link" href="/resources/">Go to the resource library</a>
      </div>

      <div class="resource-rationale">
        <EditableCopy copyId="copy-59146d041eb03e04" as="h3" />
        <ul>
          <EditableCopy copyId="copy-dd101c53be416718" as="li" />
          <EditableCopy copyId="copy-6320824e63e3b9c5" as="li" />
        </ul>
        <EditableCopy copyId="copy-0969348ddf1f49e7" as="p" class="small-print" />
      </div>
    </div>
  </section>
</BaseLayout>
