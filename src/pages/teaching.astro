---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/data/site';

const universityProfile = site.profiles.find((profile) => profile.label === 'University profile');
---

<BaseLayout
  title="Teaching"
  description="Bodhi McNally teaches undergraduate data science and statistics at the University of Sydney, with an emphasis on reasoning, interpretation and reproducibility."
>
  <PageHeader
    eyebrow="Teaching"
    title="Teaching quantitative thinking"
    introduction="I teach undergraduate data science and statistics as a Casual Academic in the University of Sydney’s School of Mathematics and Statistics. My aim is to help students understand what their methods say—and what they do not."
    folio="03"
  />

  <section class="section" aria-labelledby="role-title">
    <div class="container section-grid">
      <h2 class="section-label">
        <span class="section-label__number">01</span>
        <span id="role-title">Current role</span>
      </h2>
      <div class="section-copy">
        <p class="section-copy__lead">
          My teaching spans introductory data science and statistics, where good habits of reasoning matter more than memorising a sequence of commands.
        </p>
        <p>
          I work with students as they learn to frame analytical questions, interpret statistical evidence, communicate results and write code that another person can follow. Technical fluency matters, but it should serve an intelligible argument.
        </p>
        {
          universityProfile && (
            <p>
              <a class="arrow-link" href={universityProfile.href}>
                University of Sydney teaching profile
              </a>
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section class="section section--compact" aria-labelledby="approach-title">
    <div class="container">
      <h2 class="eyebrow" id="approach-title">An approach to quantitative teaching</h2>
      <div class="three-columns">
        <article class="principle">
          <span class="principle__number">01</span>
          <h3>Reason before procedure</h3>
          <p>
            Begin with the question, observational unit and structure of the data. A method is easier to choose—and harder to misuse—once these are clear.
          </p>
        </article>
        <article class="principle">
          <span class="principle__number">02</span>
          <h3>Interpret before reporting</h3>
          <p>
            Translate output into context, units and uncertainty. A correct calculation is incomplete if its meaning cannot be stated precisely.
          </p>
        </article>
        <article class="principle">
          <span class="principle__number">03</span>
          <h3>Make work reproducible</h3>
          <p>
            Organise data and code so that the path from raw material to conclusion remains visible, reviewable and possible to repeat.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="teaching-research-title">
    <div class="container section-grid">
      <h2 class="section-label">
        <span class="section-label__number">02</span>
        <span id="teaching-research-title">Teaching & research</span>
      </h2>
      <div class="section-copy">
        <p class="section-copy__lead">
          Teaching sharpens the same habits that strong clinical research requires: clear questions, proportionate claims and transparent reasoning.
        </p>
        <p>
          It also informs my interest in how students and prevocational doctors enter academic work. Early research experience should involve genuine contribution, careful supervision and the gradual development of independence—not simply proximity to a project.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="resources-title">
    <div class="container section-grid">
      <h2 class="section-label">
        <span class="section-label__number">03</span>
        <span id="resources-title">Student resources</span>
      </h2>
      <div class="section-copy">
        <p class="section-copy__lead">
          The Resources library is designed for concise, original notes and worked examples in statistics, data science and reproducible analysis.
        </p>
        <a class="arrow-link" href="/resources/">Browse resources</a>
      </div>
    </div>
  </section>
</BaseLayout>
