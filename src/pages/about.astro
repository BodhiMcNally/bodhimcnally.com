---
import EditableCopy from '@/components/EditableCopy.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Portrait from '@/components/Portrait.astro';
import LiveCv from '@/components/LiveCv.astro';
import { site } from '@/data/site';
---

<BaseLayout
  title="About"
  description="About Bodhi McNally: a University of Sydney medical student with a background in data science, healthcare analytics and university teaching."
  ogType="profile"
>
  <PageHeader title="About" cmsTitle="copy-572324a8fbdae9cf" />

  <section class="about-opening container" aria-label="Professional biography">
    <aside class="about-sidebar">
      <Portrait variant="about" />

      <section class="appearances" aria-labelledby="appearances-title">
        <EditableCopy copyId="copy-1f62f8b1c9e51714" as="h2" id="appearances-title" />
        <ul>
          {
            site.appearances.map((appearance) => (
              <li>
                <time datetime={String(appearance.year)}>{appearance.year}</time>
                <div>
                  <p>{appearance.event}</p>
                  <span>{appearance.location}</span>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </aside>

    <div class="about-narrative">
      <EditableCopy copyId="copy-01927021dac2e6b9" as="p" />

      <EditableCopy copyId="copy-dc60790a14a664a5" as="p" />

      <EditableCopy copyId="copy-21f14744d51b43c4" as="p" />

      <EditableCopy copyId="copy-8230ce21c407961c" as="p" />

      <EditableCopy copyId="copy-756df4f8282afb45" as="p" />
    </div>
  </section>

  <LiveCv cv={site.cv} />
</BaseLayout>
