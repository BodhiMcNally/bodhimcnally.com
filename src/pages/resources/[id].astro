---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import 'katex/dist/katex.min.css';

import BaseLayout from '@/layouts/BaseLayout.astro';
import AnnotationLayer from '@/components/AnnotationLayer.astro';
import QuartoLab from '@/components/QuartoLab.astro';
import GitPractice from '@/components/GitPractice.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const resources = await getCollection('resources', ({ data }) => !data.draft);
  return resources.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'resources'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const updated = entry.data.updated ?? entry.data.published;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);

const canonicalPath = `/resources/${entry.id}/`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: entry.data.title,
  description: entry.data.description,
  url: new URL(canonicalPath, site.canonicalUrl).toString(),
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.canonicalUrl,
  },
  datePublished: entry.data.published.toISOString(),
  dateModified: updated.toISOString(),
  educationalLevel: entry.data.level,
  about: entry.data.tags,
  inLanguage: 'en-AU',
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={canonicalPath}
  ogType="article"
  structuredData={structuredData}
  publishedTime={entry.data.published.toISOString()}
  modifiedTime={updated.toISOString()}
>
  <div
    class="reading-progress"
    role="progressbar"
    aria-label="Reading progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    data-reading-progress
  >
    <span data-reading-progress-bar></span>
  </div>
  <p class="reading-position" data-reading-position data-estimated-minutes={entry.data.estimatedMinutes}>
    <span data-reading-time>{entry.data.estimatedMinutes} min left</span>
    <span aria-hidden="true">·</span>
    <span data-reading-percent>0%</span>
  </p>

  <article data-browser-r={String(entry.data.browserR)}>
    <header class="resource-header container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/resources/">Resources</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{entry.data.title}</span>
      </nav>

      <p class="eyebrow">{entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p class="resource-header__description">{entry.data.description}</p>
      <div class="resource-meta" aria-label="Resource details">
        <span>{entry.data.level}</span>
        <span>{entry.data.estimatedMinutes} min read</span>
        <span>Published {formatDate(entry.data.published)}</span>
        {
          entry.data.updated &&
            entry.data.updated.getTime() !== entry.data.published.getTime() && (
              <span>Updated {formatDate(entry.data.updated)}</span>
            )
        }
      </div>

      <div class="resource-actions">
        <button class="button button--quiet" type="button" data-copy-page-link>
          Copy link
        </button>
        <button class="button button--quiet" type="button" data-copy-citation>
          Copy APA citation
        </button>
        <button class="button button--quiet" type="button" data-save-resource aria-pressed="false">
          Save resource
        </button>
        <button class="button button--quiet" type="button" data-open-annotations>
          My notes
        </button>
        <button class="button button--quiet" type="button" data-print-page>
          Print or save as PDF
        </button>
        {
          entry.data.externalRepository && (
            <a class="button button--quiet" href={entry.data.externalRepository.href}>
              {entry.data.externalRepository.label}
            </a>
          )
        }
      </div>
    </header>

    <div class="resource-layout container">
      <aside class="resource-layout__aside">
        {entry.data.template && <p class="badge">Example</p>}
        <TableOfContents headings={headings} />
      </aside>
      <div>
        {entry.id === 'quarto-documents-in-rstudio' && <QuartoLab />}
        {entry.id === 'git-and-github-from-first-commit' && <GitPractice />}

        <div class="prose">
          <Content />
        </div>

        {
          entry.data.downloadableAssets.length > 0 && (
            <section class="output-group" aria-labelledby="downloads-title">
              <h2 id="downloads-title">Downloads</h2>
              <ul class="output-list">
                {entry.data.downloadableAssets.map((asset) => (
                  <li>
                    <div>
                      <p class="output-list__title">{asset.label}</p>
                      {asset.description && <p class="output-list__meta">{asset.description}</p>}
                    </div>
                    <a href={asset.href} download>Download</a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <aside class="disclaimer" aria-labelledby="resource-disclaimer-title">
          <h2 id="resource-disclaimer-title">Independent resource</h2>
          <p>
            <strong>These resources are independently prepared and are not official University of Sydney course materials.</strong>
            Check your course guidance and comply with its academic-integrity requirements.
          </p>
        </aside>
      </div>
    </div>
  </article>

  <AnnotationLayer resourceTitle={entry.data.title} resourceId={entry.id} />

  <script is:inline type="module">
    const progress = document.querySelector('[data-reading-progress]');
    const progressBar = document.querySelector('[data-reading-progress-bar]');
    const readingPosition = document.querySelector('[data-reading-position]');
    const readingTime = document.querySelector('[data-reading-time]');
    const readingPercent = document.querySelector('[data-reading-percent]');
    const resourceArticle = document.querySelector('article');

    if (progress && progressBar && resourceArticle) {
      let progressFrame;
      const updateReadingProgress = () => {
        progressFrame = undefined;
        const articleTop = resourceArticle.getBoundingClientRect().top + window.scrollY;
        const distance = Math.max(resourceArticle.offsetHeight - window.innerHeight, 1);
        const value = Math.min(1, Math.max(0, (window.scrollY - articleTop) / distance));
        progressBar.style.transform = `scaleX(${value})`;
        progress.setAttribute('aria-valuenow', String(Math.round(value * 100)));
        if (readingPosition && readingTime && readingPercent) {
          const percent = Math.round(value * 100);
          const totalMinutes = Number(readingPosition.dataset.estimatedMinutes ?? 1);
          const remainingMinutes = Math.max(1, Math.ceil(totalMinutes * (1 - value)));
          readingTime.textContent = value >= 0.985 ? 'Complete' : `${remainingMinutes} min left`;
          readingPercent.textContent = `${percent}%`;
          readingPosition.dataset.visible = String(value > 0.025);
        }
      };

      const requestProgressUpdate = () => {
        if (progressFrame) return;
        progressFrame = window.requestAnimationFrame(updateReadingProgress);
      };

      updateReadingProgress();
      window.addEventListener('scroll', requestProgressUpdate, { passive: true });
      window.addEventListener('resize', requestProgressUpdate);
    }

    let webRInstancePromise;
    let ggplotInstallPromise;
    let ubuntuInstallPromise;

    const ubuntuFonts = [
      { file: 'Ubuntu-Light.ttf', weight: '300', style: 'normal' },
      { file: 'Ubuntu-LightItalic.ttf', weight: '300', style: 'italic' },
      { file: 'Ubuntu-Regular.ttf', weight: '400', style: 'normal' },
      { file: 'Ubuntu-Italic.ttf', weight: '400', style: 'italic' },
      { file: 'Ubuntu-Medium.ttf', weight: '500', style: 'normal' },
      { file: 'Ubuntu-MediumItalic.ttf', weight: '500', style: 'italic' },
      { file: 'Ubuntu-Bold.ttf', weight: '700', style: 'normal' },
      { file: 'Ubuntu-BoldItalic.ttf', weight: '700', style: 'italic' },
    ];

    const loadWebR = async () => {
      if (!webRInstancePromise) {
        webRInstancePromise = (async () => {
          const { WebR } = await import('https://webr.r-wasm.org/v0.6.0/webr.mjs');
          const webR = new WebR();
          await webR.init();
          return webR;
        })();
      }

      return webRInstancePromise;
    };

    const ensureUbuntu = async (webR) => {
      if (!ubuntuInstallPromise) {
        ubuntuInstallPromise = (async () => {
          const fontDirectory = '/home/web_user/fonts';
          try {
            await webR.FS.mkdir(fontDirectory);
          } catch {
            // The standard webR distribution may already provide this directory.
          }

          await Promise.all(
            ubuntuFonts.map(async ({ file }) => {
              const response = await fetch(`/fonts/${file}`);
              if (!response.ok) throw new Error(`Could not load ${file}.`);
              const bytes = new Uint8Array(await response.arrayBuffer());
              await webR.FS.writeFile(`${fontDirectory}/${file}`, bytes);
            }),
          );

          const workerFontInstaller = `(() => {
            if (typeof FontFace === 'undefined' || !globalThis.fonts) {
              throw new Error('This browser cannot install fonts in the plotting worker.');
            }

            const specifications = ${JSON.stringify(ubuntuFonts)};
            for (const specification of specifications) {
              const path = '/home/web_user/fonts/' + specification.file;
              const bytes = Module.FS.readFile(path);
              const data = Uint8Array.from(bytes).buffer;
              const face = new FontFace('Ubuntu', data, {
                weight: specification.weight,
                style: specification.style
              });
              globalThis.fonts.add(face);
            }
            if (!globalThis.fonts.check('16px Ubuntu')) {
              throw new Error('Ubuntu was not registered with the plotting worker.');
            }
            return 1;
          })()`;

          await webR.evalRVoid(`webr::eval_js(${JSON.stringify(workerFontInstaller)})`);
        })();
      }

      await ubuntuInstallPromise;
    };

    const ensurePackages = async (webR, code) => {
      const usesGgplot2 =
        /(?:library|require)\s*\(\s*["']?ggplot2["']?\s*\)/i.test(code) ||
        /ggplot2::/i.test(code);

      if (!usesGgplot2) return;

      if (!ggplotInstallPromise) {
        ggplotInstallPromise = webR.installPackages(['ggplot2']);
      }

      await ggplotInstallPromise;
    };

    const showOutputMessage = (output, message, isError = false) => {
      output.replaceChildren();
      const status = document.createElement('p');
      status.className = isError ? 'r-output__status r-output__status--error' : 'r-output__status';
      status.textContent = message;
      output.append(status);
    };

    document.querySelectorAll('.prose pre').forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-block')) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.before(wrapper);
      wrapper.append(pre);

      const toolbar = document.createElement('div');
      toolbar.className = 'code-toolbar';
      pre.before(toolbar);

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'code-control';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', 'Copy code to clipboard');
      toolbar.append(copyButton);

      copyButton.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
        try {
          await navigator.clipboard.writeText(code);
          copyButton.textContent = 'Copied';
          window.setTimeout(() => {
            copyButton.textContent = 'Copy';
          }, 1600);
        } catch {
          copyButton.textContent = 'Select code';
        }
      });

      const language = pre.dataset.language ?? '';
      if (language.toLowerCase() !== 'r' || resourceArticle?.dataset.browserR === 'false') return;

      const runButton = document.createElement('button');
      runButton.type = 'button';
      runButton.className = 'code-control code-control--run';
      runButton.textContent = 'Run R';
      toolbar.prepend(runButton);

      const output = document.createElement('div');
      output.className = 'r-output';
      output.hidden = true;
      output.setAttribute('aria-live', 'polite');
      output.setAttribute('aria-label', 'R output');
      wrapper.append(output);

      runButton.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
        runButton.disabled = true;
        runButton.textContent = 'Loading R…';
        output.hidden = false;
        showOutputMessage(output, 'Starting R in your browser…');

        try {
          const usesUbuntu = /["']Ubuntu["']|theme_bodhi/i.test(code);
          if (usesUbuntu && 'fonts' in document) {
            await Promise.all([
              document.fonts.load('400 16px Ubuntu'),
              document.fonts.load('700 16px Ubuntu'),
            ]);
          }

          const webR = await loadWebR();
          if (usesUbuntu) {
            runButton.textContent = 'Loading Ubuntu…';
            showOutputMessage(output, 'Installing Ubuntu in the plotting environment…');
            await ensureUbuntu(webR);
          }
          if (/(?:library|require)\s*\(\s*["']?ggplot2["']?\s*\)|ggplot2::/i.test(code)) {
            runButton.textContent = 'Loading ggplot2…';
            showOutputMessage(output, 'Loading ggplot2 and its dependencies…');
          }
          await ensurePackages(webR, code);
          runButton.textContent = 'Running…';
          showOutputMessage(output, 'Running code…');

          const shelter = await new webR.Shelter();
          try {
            const capture = await shelter.captureR(code, {
              captureGraphics: {
                width: 560,
                height: 400,
                bg: '#fcfaf6',
              },
            });

            output.replaceChildren();

            const streamText = capture.output
              .filter((message) => message.type === 'stdout' || message.type === 'stderr')
              .map((message) => message.data)
              .join('\n');

            if (streamText) {
              const textOutput = document.createElement('pre');
              textOutput.className = 'r-output__text';
              textOutput.textContent = streamText;
              output.append(textOutput);
            }

            capture.images.forEach((image, index) => {
              const canvas = document.createElement('canvas');
              canvas.className = 'r-output__plot';
              canvas.width = image.width;
              canvas.height = image.height;
              canvas.setAttribute('role', 'img');
              canvas.setAttribute('aria-label', `Plot ${index + 1} produced by the R code`);
              const context = canvas.getContext('2d');
              context?.drawImage(image, 0, 0, image.width, image.height);
              output.append(canvas);
              image.close?.();
            });

            if (!streamText && capture.images.length === 0) {
              showOutputMessage(output, 'Code ran without printed or graphical output.');
            }
          } finally {
            await shelter.purge();
          }
          runButton.textContent = 'Run again';
        } catch (error) {
          showOutputMessage(
            output,
            error instanceof Error ? error.message : 'The R code could not be run.',
            true,
          );
          runButton.textContent = 'Try again';
        } finally {
          runButton.disabled = false;
        }
      });
    });
  </script>
</BaseLayout>
