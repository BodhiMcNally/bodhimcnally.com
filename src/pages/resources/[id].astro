---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import 'katex/dist/katex.min.css';

import BaseLayout from '@/layouts/BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import { site } from '@/data/site';

export async function getStaticPaths() {
  const resources = await getCollection('resources', ({ data }) => !data.draft);
  return resources.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'resources'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const updated = entry.data.updated ?? entry.data.published;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-AU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);

const canonicalPath = `/resources/${entry.id}/`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: entry.data.title,
  description: entry.data.description,
  url: new URL(canonicalPath, site.canonicalUrl).toString(),
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.canonicalUrl,
  },
  datePublished: entry.data.published.toISOString(),
  dateModified: updated.toISOString(),
  educationalLevel: entry.data.level,
  about: entry.data.tags,
  inLanguage: 'en-AU',
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={canonicalPath}
  ogType="article"
  structuredData={structuredData}
  publishedTime={entry.data.published.toISOString()}
  modifiedTime={updated.toISOString()}
>
  <article>
    <header class="resource-header container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/resources/">Resources</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{entry.data.title}</span>
      </nav>

      <p class="eyebrow">{entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p class="resource-header__description">{entry.data.description}</p>
      <div class="resource-meta" aria-label="Resource details">
        <span>{entry.data.level}</span>
        <span>{entry.data.estimatedMinutes} min read</span>
        <span>Published {formatDate(entry.data.published)}</span>
        {
          entry.data.updated &&
            entry.data.updated.getTime() !== entry.data.published.getTime() && (
              <span>Updated {formatDate(entry.data.updated)}</span>
            )
        }
      </div>

      <div class="resource-actions">
        <button class="button button--quiet" type="button" data-print-resource>
          Print or save as PDF
        </button>
        {
          entry.data.externalRepository && (
            <a class="button button--quiet" href={entry.data.externalRepository.href}>
              {entry.data.externalRepository.label}
            </a>
          )
        }
      </div>
    </header>

    <div class="resource-layout container">
      <aside class="resource-layout__aside">
        {entry.data.template && <p class="badge">Example</p>}
        <TableOfContents headings={headings} />
      </aside>
      <div>
        <div class="prose">
          <Content />
        </div>

        {
          entry.data.downloadableAssets.length > 0 && (
            <section class="output-group" aria-labelledby="downloads-title">
              <h2 id="downloads-title">Downloads</h2>
              <ul class="output-list">
                {entry.data.downloadableAssets.map((asset) => (
                  <li>
                    <div>
                      <p class="output-list__title">{asset.label}</p>
                      {asset.description && <p class="output-list__meta">{asset.description}</p>}
                    </div>
                    <a href={asset.href} download>Download</a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <aside class="disclaimer" aria-labelledby="resource-disclaimer-title">
          <h2 id="resource-disclaimer-title">Independent resource</h2>
          <p>
            <strong>These resources are independently prepared and are not official University of Sydney course materials.</strong>
            Check your course guidance and comply with its academic-integrity requirements.
          </p>
        </aside>
      </div>
    </div>
  </article>

  <script>
    document.querySelector<HTMLButtonElement>('[data-print-resource]')?.addEventListener('click', () => {
      window.print();
    });

    let webRInstancePromise: Promise<any> | undefined;

    const loadWebR = async () => {
      if (!webRInstancePromise) {
        webRInstancePromise = (async () => {
          const moduleUrl = 'https://webr.r-wasm.org/v0.6.0/webr.mjs';
          const { WebR } = await import(/* @vite-ignore */ moduleUrl);
          const webR = new WebR();
          await webR.init();
          return webR;
        })();
      }

      return webRInstancePromise;
    };

    document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-block')) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.before(wrapper);
      wrapper.append(pre);

      const toolbar = document.createElement('div');
      toolbar.className = 'code-toolbar';
      pre.before(toolbar);

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'code-control';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', 'Copy code to clipboard');
      toolbar.append(copyButton);

      copyButton.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
        try {
          await navigator.clipboard.writeText(code);
          copyButton.textContent = 'Copied';
          window.setTimeout(() => {
            copyButton.textContent = 'Copy';
          }, 1600);
        } catch {
          copyButton.textContent = 'Select code';
        }
      });

      const language = pre.dataset.language ?? '';
      if (language.toLowerCase() !== 'r') return;

      const runButton = document.createElement('button');
      runButton.type = 'button';
      runButton.className = 'code-control code-control--run';
      runButton.textContent = 'Run R';
      toolbar.prepend(runButton);

      const output = document.createElement('pre');
      output.className = 'r-output';
      output.hidden = true;
      output.setAttribute('aria-live', 'polite');
      output.setAttribute('aria-label', 'R output');
      wrapper.append(output);

      runButton.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
        runButton.disabled = true;
        runButton.textContent = 'Loading R…';
        output.hidden = false;
        output.textContent = 'Starting R in your browser…';

        try {
          const webR = await loadWebR();
          runButton.textContent = 'Running…';
          const expression = `paste(capture.output({\n${code}\n}), collapse = "\\n")`;
          const result = await webR.evalR(expression);
          try {
            const value = await result.toString();
            output.textContent = value || 'Code ran without printed output.';
          } finally {
            webR.destroy(result);
          }
          runButton.textContent = 'Run again';
        } catch (error) {
          output.textContent = error instanceof Error ? error.message : 'The R code could not be run.';
          runButton.textContent = 'Try again';
        } finally {
          runButton.disabled = false;
        }
      });
    });
  </script>
</BaseLayout>
