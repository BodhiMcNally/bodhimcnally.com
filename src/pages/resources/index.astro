---
import EditableCopy from '@/components/EditableCopy.astro';
import { getCollection } from 'astro:content';

import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';

const resources = (await getCollection('resources', ({ data }) => !data.draft)).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    (b.data.updated ?? b.data.published).getTime() -
      (a.data.updated ?? a.data.published).getTime() ||
    b.data.published.getTime() - a.data.published.getTime(),
);

const categories = [...new Set(resources.map((resource) => resource.data.category))].sort();
const tags = [...new Set(resources.flatMap((resource) => resource.data.tags))].sort();
const showBrowseTools = resources.length >= 4;
const offlineUrls = [
  '/resources/', '/resources/lab/', '/resources/notebook/', '/resources/interpretation-clinic/',
  '/resources/prediction-lab/',
  ...resources.map((resource) => `/resources/${resource.id}/`),
];
---

<BaseLayout
  title="Resources"
  description="Original teaching resources by Bodhi McNally in statistics, data science, statistical reasoning and reproducible research."
>
  <PageHeader
    title="Resources"
    introduction="Notes, code and additional material developed to supplement my classroom teaching." cmsTitle="copy-9181c8611d0a5753" />

  <section class="resource-purpose" aria-labelledby="resource-purpose-title">
    <div class="container resource-purpose__inner">
      <div>
        <EditableCopy copyId="copy-ec99c436c40702c7" as="h2" id="resource-purpose-title" />
        <EditableCopy copyId="copy-198354d33c163c59" as="p" />
      </div>
      <div>
        <EditableCopy copyId="copy-6a5f78ca9747eec9" as="p" />
        <EditableCopy copyId="copy-cf7ea3f18e8cf049" as="p" class="small-print" />
      </div>
    </div>
  </section>

  <section class="resource-workbench" aria-labelledby="workbench-title">
    <div class="container">
      <div class="section-heading">
        <EditableCopy copyId="copy-62e53e63dc66d386" as="p" class="eyebrow" />
        <EditableCopy copyId="copy-c3721e1365cfff9e" as="h2" id="workbench-title" />
        <EditableCopy copyId="copy-667ce99401ab31ef" as="p" />
      </div>
      <ol class="workbench-list">
        <li><a href="/resources/lab/"><span>01</span><div><EditableCopy copyId="copy-066d55cacddc2718" as="h3" /><EditableCopy copyId="copy-59007bfc6035c501" as="p" /></div><strong aria-hidden="true">→</strong></a></li>
        <li><a href="/resources/prediction-lab/"><span>02</span><div><EditableCopy copyId="copy-a47e99ff6c620dfa" as="h3" /><EditableCopy copyId="copy-3723167bccf835db" as="p" /></div><strong aria-hidden="true">→</strong></a></li>
        <li><a href="/resources/interpretation-clinic/"><span>03</span><div><EditableCopy copyId="copy-68fdb82bc5d8e110" as="h3" /><EditableCopy copyId="copy-58c8cd9ad04a5bc2" as="p" /></div><strong aria-hidden="true">→</strong></a></li>
        <li><a href="/resources/quarto-documents-in-rstudio/"><span>04</span><div><EditableCopy copyId="copy-4b081541483ee946" as="h3" /><EditableCopy copyId="copy-7dc58ccb75f591cd" as="p" /></div><strong aria-hidden="true">→</strong></a></li>
      </ol>
      <div class="offline-resources">
        <div><EditableCopy copyId="copy-05b7ca4e162a0828" as="h3" /><EditableCopy copyId="copy-f2a902995b18564a" as="p" /></div>
        <button class="button button--quiet" type="button" data-cache-resources>Save resources offline</button>
        <p aria-live="polite" data-cache-status></p>
      </div>
      <script is:inline type="application/json" data-offline-urls set:html={JSON.stringify(offlineUrls)}></script>
    </div>
  </section>

  <section class="resources-library" aria-labelledby="browse-title">
    <div class="container">
      <div class="section-heading section-heading--with-action">
        <EditableCopy copyId="copy-5b161afdb34a0b9e" as="h2" id="browse-title" />
        <a class="text-link" href="/resources/notebook/">My resource notebook</a>
      </div>

      {
        showBrowseTools && (
          <div class="resource-toolbar" data-resource-toolbar>
            <div class="resource-toolbar__fields">
              <div class="field">
                <EditableCopy copyId="copy-06ea292de11bd2d4" as="label" for="resource-search" />
                <input
                  id="resource-search"
                  type="search"
                  placeholder="Search titles, descriptions and tags"
                  autocomplete="off"
                  data-resource-search
                />
              </div>
              <div class="field">
                <EditableCopy copyId="copy-9cfbddb6dde6951c" as="label" for="resource-category" />
                <select id="resource-category" data-resource-category>
                  <option value="">All categories</option>
                  {categories.map((category) => <option value={category.toLowerCase()}>{category}</option>)}
                </select>
              </div>
              <div class="field">
                <EditableCopy copyId="copy-39a71e77c7afdfbd" as="label" for="resource-tag" />
                <select id="resource-tag" data-resource-tag>
                  <option value="">All tags</option>
                  {tags.map((tag) => <option value={tag.toLowerCase()}>{tag}</option>)}
                </select>
              </div>
              <button class="button button--quiet" type="button" data-resource-reset>Reset</button>
            </div>
            <p class="resource-toolbar__status" aria-live="polite" data-resource-status>
              {resources.length} {resources.length === 1 ? 'resource' : 'resources'}
            </p>
          </div>
        )
      }

      <ol class="resource-list" data-resource-list>
        {
          resources.map((resource) => (
            <li
              class="resource-row"
              data-resource
              data-search={`${resource.data.title} ${resource.data.description} ${resource.data.category} ${resource.data.tags.join(' ')} ${resource.data.software.join(' ')}`.toLowerCase()}
              data-category={resource.data.category.toLowerCase()}
              data-tags={resource.data.tags.map((tag) => tag.toLowerCase()).join('|')}
            >
              <div>
                <h3 class="resource-row__title">
                  <a href={`/resources/${resource.id}/`}>{resource.data.title}</a>
                </h3>
                <p class="resource-row__description">{resource.data.description}</p>
              </div>
              <div class="resource-row__meta">
                <p>{resource.data.category} · {resource.data.estimatedMinutes} min</p>
                {resource.data.template && <span class="badge">Example</span>}
                <ul class="tag-list" aria-label="Tags">
                  {resource.data.tags.map((tag) => <li class="tag">{tag}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>

      <EditableCopy copyId="copy-d341d8e3ca31c159" as="p" class="empty-state" data-resource-empty data-visible="false" />
    </div>
  </section>

  <section class="resource-disclaimer" aria-labelledby="resource-note-title">
    <div class="container disclaimer">
      <EditableCopy copyId="copy-a23a7e7de46d152b" as="h2" id="resource-note-title" />
      <EditableCopy copyId="copy-8142a3401d0e4c9e" as="p" />
    </div>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>('[data-resource-search]');
    const category = document.querySelector<HTMLSelectElement>('[data-resource-category]');
    const tag = document.querySelector<HTMLSelectElement>('[data-resource-tag]');
    const reset = document.querySelector<HTMLButtonElement>('[data-resource-reset]');
    const status = document.querySelector<HTMLElement>('[data-resource-status]');
    const empty = document.querySelector<HTMLElement>('[data-resource-empty]');
    const items = [...document.querySelectorAll<HTMLElement>('[data-resource]')];

    const applyFilters = () => {
      const query = search?.value.trim().toLowerCase() ?? '';
      const selectedCategory = category?.value ?? '';
      const selectedTag = tag?.value ?? '';
      let visible = 0;

      items.forEach((item) => {
        const haystack = item.dataset.search ?? '';
        const itemCategory = item.dataset.category ?? '';
        const itemTags = (item.dataset.tags ?? '').split('|');
        const matches =
          (!query || haystack.includes(query)) &&
          (!selectedCategory || itemCategory === selectedCategory) &&
          (!selectedTag || itemTags.includes(selectedTag));

        item.hidden = !matches;
        if (matches) visible += 1;
      });

      if (status) status.textContent = `${visible} ${visible === 1 ? 'resource' : 'resources'}`;
      if (empty) empty.dataset.visible = String(visible === 0);
    };

    search?.addEventListener('input', applyFilters);
    category?.addEventListener('change', applyFilters);
    tag?.addEventListener('change', applyFilters);
    reset?.addEventListener('click', () => {
      if (search) search.value = '';
      if (category) category.value = '';
      if (tag) tag.value = '';
      applyFilters();
      search?.focus();
    });

    const cacheButton = document.querySelector<HTMLButtonElement>('[data-cache-resources]');
    const cacheStatus = document.querySelector<HTMLElement>('[data-cache-status]');
    cacheButton?.addEventListener('click', async () => {
      if (!('serviceWorker' in navigator)) { if (cacheStatus) cacheStatus.textContent = 'Offline saving is not supported by this browser.'; return; }
      cacheButton.disabled = true;
      if (cacheStatus) cacheStatus.textContent = 'Saving resources…';
      try {
        const registration = await navigator.serviceWorker.ready;
        const urls = JSON.parse(document.querySelector('[data-offline-urls]')?.textContent ?? '[]');
        const worker = registration.active;
        if (!worker) throw new Error('Worker unavailable');
        const channel = new MessageChannel();
        channel.port1.onmessage = (event) => { if (cacheStatus) cacheStatus.textContent = `${event.data.count} pages and tools saved for offline use.`; cacheButton.disabled = false; cacheButton.textContent = 'Refresh offline copy'; };
        worker.postMessage({ type: 'CACHE_URLS', urls }, [channel.port2]);
      } catch { if (cacheStatus) cacheStatus.textContent = 'The offline copy could not be completed. Try again after reloading the page.'; cacheButton.disabled = false; }
    });
  </script>
</BaseLayout>
