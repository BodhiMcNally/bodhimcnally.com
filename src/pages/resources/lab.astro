---
import EditableCopy from '@/components/EditableCopy.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import SimulationStudio from '@/components/SimulationStudio.astro';
---

<BaseLayout
  title="Statistical simulation studio"
  description="Interactive, reproducible simulations for confidence intervals, sampling distributions and statistical power."
>
  <PageHeader
    title="Statistical simulation studio"
    introduction="Change the assumptions, rerun the experiment and inspect what happens across repeated samples." cmsTitle="copy-6cb0ced04c9f39b5" />
  <div class="workbench-page container">
    <SimulationStudio />
    <aside class="disclaimer workbench-disclaimer">
      <EditableCopy copyId="copy-c2091c3319b6f238" as="h2" />
      <EditableCopy copyId="copy-5687df8ed4e8286b" as="p" />
    </aside>
  </div>
</BaseLayout>
