---
import EditableCopy from '@/components/EditableCopy.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ReproducibilityInspector from '@/components/ReproducibilityInspector.astro';
---

<BaseLayout title="Reproducibility inspector" description="A private, browser-only audit for R and Quarto projects.">
  <PageHeader title="Reproducibility inspector" introduction="Inspect an R or Quarto project for common reproducibility problems before you share or submit it." cmsTitle="copy-de0c34d3d60415ed" />
  <div class="workbench-page container">
    <ReproducibilityInspector />
    <aside class="disclaimer workbench-disclaimer">
      <EditableCopy copyId="copy-7cead2b0d46cdf6c" as="h2" />
      <EditableCopy copyId="copy-825da852313b6148" as="p" />
    </aside>
  </div>
</BaseLayout>
