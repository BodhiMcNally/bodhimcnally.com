---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProfileList from '@/components/ProfileList.astro';
---

<BaseLayout
  title="Contact"
  description="Verified academic and professional profile links for Bodhi McNally, including ORCID, University of Sydney and LinkedIn."
>
  <PageHeader title="Contact" />

  <section class="contact-page" aria-labelledby="contact-links-title">
    <div class="container contact-page__inner">
      <div>
        <h2 id="contact-links-title">Get in touch</h2>
        <p>
          If you would like to discuss or collaborate on a research, teaching or educational project, you are welcome to contact me through either email address below.
        </p>
      </div>
      <ProfileList includeEmails={true} />
    </div>
  </section>
</BaseLayout>
