<section class="git-practice" data-git-practice aria-labelledby="git-practice-title">
  <div class="git-practice__header"><div><p class="eyebrow">Safe practice terminal</p><h2 id="git-practice-title">Git sandbox</h2></div><button type="button" data-git-reset>Reset repository</button></div>
  <div class="git-practice__terminal" role="log" aria-live="polite" data-git-output><p><span>$</span> Start with <code>git status</code>, or type <code>help</code>.</p></div>
  <form class="git-practice__prompt" data-git-form><label class="visually-hidden" for="git-command">Git or shell command</label><span aria-hidden="true">$</span><input id="git-command" autocomplete="off" spellcheck="false" placeholder="git status" data-git-input><button type="submit">Run</button></form>
  <p class="git-practice__note">This is a teaching simulator, not a real shell. It recognises a deliberately limited set of safe commands and never accesses your files or GitHub account.</p>
</section>
<script>
  type Repo={initialised:boolean;files:Record<string,string>;staged:string[];commits:Array<{id:string;message:string;files:string[]}>;branch:string};const root=document.querySelector<HTMLElement>('[data-git-practice]');if(root){const output=root.querySelector<HTMLElement>('[data-git-output]')!,input=root.querySelector<HTMLInputElement>('[data-git-input]')!;let repo:Repo={initialised:false,files:{'README.md':'# My project'},staged:[],commits:[],branch:'main'};const print=(value:string,type='')=>{const p=document.createElement('p');if(type)p.dataset.type=type;p.textContent=value;output.append(p);output.scrollTop=output.scrollHeight;};const status=()=>{if(!repo.initialised)return'Not a git repository. Run git init.';const tracked=new Set(repo.commits.flatMap(commit=>commit.files));const staged=new Set(repo.staged);const untracked=Object.keys(repo.files).filter(file=>!tracked.has(file)&&!staged.has(file));return `On branch ${repo.branch}\n${repo.staged.length?`Changes to be committed:\n  ${repo.staged.join('\n  ')}`:'No changes staged.'}${untracked.length?`\nUntracked files:\n  ${untracked.join('\n  ')}`:''}`;};const run=(raw:string)=>{const command=raw.trim();print(`$ ${command}`,'command');if(!command)return;const parts=command.match(/(?:[^\s"]+|"[^"]*")+/g)?.map(value=>value.replace(/^"|"$/g,''))??[];if(command==='help'){print('Commands: pwd, ls, touch FILE, mkdir DIR, clear, git init, git status, git add FILE|., git commit -m "MESSAGE", git log, git branch, git switch -c NAME, git diff');return;}if(command==='pwd'){print('/project');return;}if(command==='ls'){print(Object.keys(repo.files).join('  ')||'(empty)');return;}if(command==='clear'){output.replaceChildren();return;}if(parts[0]==='touch'&&parts[1]){repo.files[parts[1]]='';print(`Created ${parts[1]}`);return;}if(parts[0]==='mkdir'&&parts[1]){repo.files[`${parts[1]}/`]='';print(`Created directory ${parts[1]}/`);return;}if(command==='git init'){repo.initialised=true;print('Initialized empty Git repository in /project/.git/');return;}if(command==='git status'){print(status());return;}if(command==='git branch'){print(`* ${repo.branch}`);return;}if(parts[0]==='git'&&parts[1]==='switch'&&parts[2]==='-c'&&parts[3]){if(!repo.initialised){print(status(),'error');return;}repo.branch=parts[3];print(`Switched to a new branch '${repo.branch}'`);return;}if(parts[0]==='git'&&parts[1]==='add'&&parts[2]){if(!repo.initialised){print(status(),'error');return;}const selected=parts[2]==='.'?Object.keys(repo.files):parts.slice(2).filter(file=>file in repo.files);repo.staged=[...new Set([...repo.staged,...selected])];print(selected.length?`Staged ${selected.join(', ')}`:'No matching files.','');return;}if(parts[0]==='git'&&parts[1]==='commit'&&parts[2]==='-m'&&parts[3]){if(!repo.initialised){print(status(),'error');return;}if(!repo.staged.length){print('Nothing to commit. Stage a file first.','error');return;}const id=Math.random().toString(16).slice(2,9);repo.commits.unshift({id,message:parts[3],files:[...repo.staged]});repo.staged=[];print(`[${repo.branch} ${id}] ${parts[3]}`);return;}if(command==='git log'){print(repo.commits.length?repo.commits.map(commit=>`commit ${commit.id}\n    ${commit.message}`).join('\n\n'):'No commits yet.');return;}if(command==='git diff'){print(repo.staged.length?'Staged changes are not shown by plain git diff. Try git status.':'No unstaged changes in this simplified repository.');return;}print(`Command not recognised: ${command}\nType help to see the supported commands.`,'error');};root.querySelector<HTMLFormElement>('[data-git-form]')?.addEventListener('submit',event=>{event.preventDefault();run(input.value);input.value='';});root.querySelector('[data-git-reset]')?.addEventListener('click',()=>{repo={initialised:false,files:{'README.md':'# My project'},staged:[],commits:[],branch:'main'};output.replaceChildren();print('Repository reset. Start with git status.');input.focus();});}
</script>
