---
import EditableCopy from '@/components/EditableCopy.astro';
---
<section class="academic-tool explain-result" data-explain-result aria-labelledby="explain-title">
  <header class="tool-intro"><div><EditableCopy copyId="copy-e7c41e6ea23950d2" as="p" class="eyebrow" /><EditableCopy copyId="copy-9e22c97e72e37469" as="h2" id="explain-title" /></div><EditableCopy copyId="copy-81b8c5eb4d7d13b9" as="p" /></header>
  <div class="tool-grid"><form class="tool-controls">
    <label>Model output<select data-explain="kind"><option value="linear">Linear coefficient</option><option value="odds">Odds ratio</option><option value="risk">Risk ratio</option></select></label>
    <label>Exposure or comparison<input data-explain="exposure" value="the intervention group compared with the control group"></label><label>Outcome<input data-explain="outcome" value="mean systolic blood pressure"></label><label>Estimate<input type="number" step="0.01" data-explain="estimate" value="-3.4"></label><div class="inline-fields"><label>Lower CI<input type="number" step="0.01" data-explain="lower" value="-5.8"></label><label>Upper CI<input type="number" step="0.01" data-explain="upper" value="-1.0"></label></div><label>Units<input data-explain="units" value="mmHg"></label><label>Adjustment/context<input data-explain="context" value="after adjustment for age and baseline blood pressure"></label><label><input type="checkbox" data-explain="causal"> The design and assumptions justify causal language</label>
  </form><div class="tool-output"><div class="explanation-preview"><EditableCopy copyId="copy-b21e109eca617123" as="p" class="eyebrow" /><blockquote data-explain-preview></blockquote></div><ul class="explanation-checks" data-explain-checks></ul></div></div>
  <div class="tool-actions"><button type="button" data-explain-copy>Copy interpretation</button></div>
</section>
<script>
  const root=document.querySelector<HTMLElement>('[data-explain-result]');if(root){const get=(name:string)=>root.querySelector<HTMLInputElement|HTMLSelectElement>(`[data-explain="${name}"]`);const preview=root.querySelector<HTMLElement>('[data-explain-preview]')!;const update=()=>{const kind=get('kind')?.value??'linear', estimate=Number(get('estimate')?.value),lower=Number(get('lower')?.value),upper=Number(get('upper')?.value),exposure=get('exposure')?.value.trim()||'[comparison]',outcome=get('outcome')?.value.trim()||'[outcome]',units=get('units')?.value.trim(),context=get('context')?.value.trim(),causal=(get('causal') as HTMLInputElement)?.checked;let sentence='';if(kind==='linear')sentence=`${exposure} ${causal?'reduced':'was associated with an estimated difference in'} ${outcome} of ${estimate} ${units} (95% CI ${lower} to ${upper})${context?`, ${context}`:''}.`;else{const label=kind==='odds'?'odds':'risk';const direction=estimate>=1?`${((estimate-1)*100).toFixed(0)}% higher`:`${((1-estimate)*100).toFixed(0)}% lower`;sentence=`${exposure} ${causal?'produced':'was associated with'} ${direction} ${label} of ${outcome} (${kind==='odds'?'OR':'RR'} ${estimate.toFixed(2)}, 95% CI ${lower.toFixed(2)}–${upper.toFixed(2)})${context?`, ${context}`:''}.`;}preview.textContent=sentence;const checks=[['Comparison specified',!exposure.includes('[')],['Outcome specified',!outcome.includes('[')],['Uncertainty reported',Number.isFinite(lower)&&Number.isFinite(upper)],['Null value considered',kind==='linear'?(lower<=0&&upper>=0):(lower<=1&&upper>=1)],['Causal wording',causal]];const list=root.querySelector<HTMLElement>('[data-explain-checks]')!;list.replaceChildren(...checks.map(([label,state])=>{const li=document.createElement('li');li.dataset.state=String(state);li.textContent=`${state?'✓':'○'} ${label}${label==='Null value considered'&&state?' — interval includes the null':''}${label==='Causal wording'&&!state?' — association wording retained':''}`;return li;}));};root.addEventListener('input',update);root.querySelector('[data-explain-copy]')?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(preview.textContent??'');}catch{}const button=root.querySelector<HTMLButtonElement>('[data-explain-copy]')!;button.textContent='Copied';setTimeout(()=>button.textContent='Copy interpretation',1500);});update();}
</script>
