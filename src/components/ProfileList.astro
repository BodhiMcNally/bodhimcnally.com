---
import { site } from '@/data/site';

interface Props {
  includeEmails?: boolean;
}

const { includeEmails = false } = Astro.props;
const scholar = site.optionalProfiles.googleScholar;
---

<ul class="profile-list">
  {
    includeEmails &&
      site.emails.map((email) => (
        <li>
          <a href={`mailto:${email.address}`}>
            <span class="profile-list__label">{email.label}</span>
            <span class="profile-list__detail">{email.address}</span>
            <span class="profile-list__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))
  }
  {
    site.profiles.map((profile) => (
      <li>
        <a href={profile.href} rel="me">
          <span class="profile-list__label">{profile.label}</span>
          <span class="profile-list__detail">{profile.detail}</span>
          <span class="profile-list__arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))
  }
  {
    scholar && (
      <li>
        <a href={scholar} rel="me">
          <span class="profile-list__label">Google Scholar</span>
          <span class="profile-list__detail">Research profile</span>
          <span class="profile-list__arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    )
  }
</ul>
