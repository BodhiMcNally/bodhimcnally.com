<section class="simulation-studio" data-simulation-studio aria-labelledby="simulation-title">
  <div class="simulation-studio__topbar">
    <div>
      <p class="eyebrow">Browser laboratory</p>
      <h2 id="simulation-title">Statistical simulation studio</h2>
    </div>
    <p>Calculations run on this device using a reproducible random seed.</p>
  </div>

  <div class="simulation-tabs" role="tablist" aria-label="Choose an experiment">
    <button type="button" role="tab" aria-selected="true" aria-controls="experiment-confidence" id="tab-confidence" data-experiment-tab="confidence">Confidence intervals</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="experiment-sampling" id="tab-sampling" data-experiment-tab="sampling" tabindex="-1">Sampling distributions</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="experiment-power" id="tab-power" data-experiment-tab="power" tabindex="-1">Statistical power</button>
  </div>

  <div class="simulation-workspace">
    <aside class="simulation-controls">
      <section role="tabpanel" id="experiment-confidence" aria-labelledby="tab-confidence" data-experiment-panel="confidence">
        <div class="simulation-field">
          <label for="confidence-n">Sample size <output for="confidence-n" data-output="confidence-n">30</output></label>
          <input id="confidence-n" type="range" min="5" max="200" value="30" step="1" data-parameter="n" />
        </div>
        <div class="simulation-field">
          <label for="confidence-level">Confidence level <output for="confidence-level" data-output="confidence-level">95%</output></label>
          <select id="confidence-level" data-parameter="confidence">
            <option value="0.8">80%</option><option value="0.9">90%</option><option value="0.95" selected>95%</option><option value="0.99">99%</option>
          </select>
        </div>
        <div class="simulation-field">
          <label for="confidence-sims">Simulated samples <output for="confidence-sims" data-output="confidence-sims">500</output></label>
          <input id="confidence-sims" type="range" min="100" max="2000" value="500" step="100" data-parameter="simulations" />
        </div>
      </section>

      <section role="tabpanel" id="experiment-sampling" aria-labelledby="tab-sampling" data-experiment-panel="sampling" hidden>
        <div class="simulation-field">
          <label for="sampling-n">Observations per sample <output for="sampling-n" data-output="sampling-n">10</output></label>
          <input id="sampling-n" type="range" min="1" max="150" value="10" step="1" data-parameter="n" />
        </div>
        <div class="simulation-field">
          <label for="sampling-distribution">Population distribution</label>
          <select id="sampling-distribution" data-parameter="distribution">
            <option value="normal">Normal</option><option value="uniform">Uniform</option><option value="exponential" selected>Right-skewed exponential</option>
          </select>
        </div>
        <div class="simulation-field">
          <label for="sampling-sims">Sample means <output for="sampling-sims" data-output="sampling-sims">1000</output></label>
          <input id="sampling-sims" type="range" min="100" max="5000" value="1000" step="100" data-parameter="simulations" />
        </div>
      </section>

      <section role="tabpanel" id="experiment-power" aria-labelledby="tab-power" data-experiment-panel="power" hidden>
        <div class="simulation-field">
          <label for="power-n">Sample size <output for="power-n" data-output="power-n">40</output></label>
          <input id="power-n" type="range" min="5" max="300" value="40" step="1" data-parameter="n" />
        </div>
        <div class="simulation-field">
          <label for="power-effect">Standardised effect <output for="power-effect" data-output="power-effect">0.40</output></label>
          <input id="power-effect" type="range" min="0" max="1.5" value="0.4" step="0.05" data-parameter="effect" />
        </div>
        <div class="simulation-field">
          <label for="power-alpha">Significance level</label>
          <select id="power-alpha" data-parameter="alpha">
            <option value="0.01">0.01</option><option value="0.05" selected>0.05</option><option value="0.1">0.10</option>
          </select>
        </div>
        <div class="simulation-field">
          <label for="power-sims">Simulated studies <output for="power-sims" data-output="power-sims">1000</output></label>
          <input id="power-sims" type="range" min="100" max="5000" value="1000" step="100" data-parameter="simulations" />
        </div>
      </section>

      <div class="simulation-seed">
        <label for="simulation-seed">Random seed</label>
        <input id="simulation-seed" type="number" value="2026" min="1" max="2147483646" data-seed />
      </div>
      <div class="simulation-primary-actions">
        <button class="button" type="button" data-run-simulation>Run simulation</button>
        <button class="button button--quiet" type="button" data-new-seed>New seed</button>
      </div>
    </aside>

    <div class="simulation-output" aria-live="polite" aria-busy="false" data-simulation-output>
      <div class="simulation-summary" data-simulation-summary>
        <p class="eyebrow">Result</p>
        <p>Run the experiment to generate a result.</p>
      </div>
      <div class="simulation-chart" data-simulation-chart aria-label="Simulation chart"></div>
      <p class="simulation-interpretation" data-simulation-interpretation></p>
    </div>
  </div>

  <div class="simulation-secondary-actions">
    <button type="button" data-copy-r disabled>Copy reproducible R code</button>
    <button type="button" data-download-simulation disabled>Download simulated data</button>
    <button type="button" data-share-simulation>Copy link to this setup</button>
  </div>
</section>

<script>
  type Experiment = 'confidence' | 'sampling' | 'power';
  type ConfidenceInterval = { mean: number; lower: number; upper: number; covers: boolean };
  type ConfidenceResult = { type: 'confidence'; intervals: ConfidenceInterval[]; covered: number; total: number };
  type SamplingResult = { type: 'sampling'; means: number[]; mean: number; sd: number };
  type PowerResult = { type: 'power'; significant: number; total: number; statistics: number[]; critical: number };
  type SimulationResult = ConfidenceResult | SamplingResult | PowerResult;

  const studio = document.querySelector<HTMLElement>('[data-simulation-studio]');
  if (studio) {
    const tabs = [...studio.querySelectorAll<HTMLButtonElement>('[data-experiment-tab]')];
    const panels = [...studio.querySelectorAll<HTMLElement>('[data-experiment-panel]')];
    const output = studio.querySelector<HTMLElement>('[data-simulation-output]');
    const summary = studio.querySelector<HTMLElement>('[data-simulation-summary]');
    const chart = studio.querySelector<HTMLElement>('[data-simulation-chart]');
    const interpretation = studio.querySelector<HTMLElement>('[data-simulation-interpretation]');
    const seedInput = studio.querySelector<HTMLInputElement>('[data-seed]');
    const copyR = studio.querySelector<HTMLButtonElement>('[data-copy-r]');
    const downloadButton = studio.querySelector<HTMLButtonElement>('[data-download-simulation]');
    let active: Experiment = 'confidence';
    let lastResult: SimulationResult | null = null;
    let lastParameters: Record<string, string | number> = {};

    const workerSource = `
      const mulberry32 = (seed) => () => {
        let t = seed += 0x6D2B79F5;
        t = Math.imul(t ^ t >>> 15, t | 1);
        t ^= t + Math.imul(t ^ t >>> 7, t | 61);
        return ((t ^ t >>> 14) >>> 0) / 4294967296;
      };
      const normal = (random) => {
        const u = Math.max(random(), 1e-12);
        const v = random();
        return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
      };
      const zValues = { '0.8': 1.281552, '0.9': 1.644854, '0.95': 1.959964, '0.99': 2.575829 };
      const alphaZ = { '0.01': 2.575829, '0.05': 1.959964, '0.1': 1.644854 };
      self.onmessage = ({ data }) => {
        const { type, parameters, token } = data;
        const random = mulberry32(Number(parameters.seed));
        if (type === 'confidence') {
          const intervals = [];
          let covered = 0;
          for (let simulation = 0; simulation < parameters.simulations; simulation += 1) {
            const values = Array.from({ length: parameters.n }, () => normal(random));
            const mean = values.reduce((sum, value) => sum + value, 0) / values.length;
            const variance = values.reduce((sum, value) => sum + (value - mean) ** 2, 0) / (values.length - 1);
            const margin = zValues[String(parameters.confidence)] * Math.sqrt(variance / values.length);
            const lower = mean - margin;
            const upper = mean + margin;
            const covers = lower <= 0 && upper >= 0;
            if (covers) covered += 1;
            intervals.push({ mean, lower, upper, covers });
          }
          self.postMessage({ token, result: { type, intervals, covered, total: parameters.simulations } });
        } else if (type === 'sampling') {
          const means = [];
          for (let simulation = 0; simulation < parameters.simulations; simulation += 1) {
            let sum = 0;
            for (let index = 0; index < parameters.n; index += 1) {
              if (parameters.distribution === 'normal') sum += normal(random);
              else if (parameters.distribution === 'uniform') sum += (random() - 0.5) * Math.sqrt(12);
              else sum += -Math.log(Math.max(random(), 1e-12)) - 1;
            }
            means.push(sum / parameters.n);
          }
          const mean = means.reduce((sum, value) => sum + value, 0) / means.length;
          const sd = Math.sqrt(means.reduce((sum, value) => sum + (value - mean) ** 2, 0) / (means.length - 1));
          self.postMessage({ token, result: { type, means, mean, sd } });
        } else {
          let significant = 0;
          const statistics = [];
          const critical = alphaZ[String(parameters.alpha)];
          for (let simulation = 0; simulation < parameters.simulations; simulation += 1) {
            let sum = 0;
            for (let index = 0; index < parameters.n; index += 1) sum += normal(random) + parameters.effect;
            const statistic = (sum / parameters.n) * Math.sqrt(parameters.n);
            if (Math.abs(statistic) > critical) significant += 1;
            statistics.push(statistic);
          }
          self.postMessage({ token, result: { type, significant, total: parameters.simulations, statistics, critical } });
        }
      };
    `;
    const worker = new Worker(URL.createObjectURL(new Blob([workerSource], { type: 'text/javascript' })));
    let runToken = 0;

    const currentParameters = () => {
      const panel = studio.querySelector<HTMLElement>(`[data-experiment-panel="${active}"]`)!;
      const parameters: Record<string, string | number> = { seed: Number(seedInput?.value ?? 2026) };
      panel.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-parameter]').forEach((control) => {
        parameters[control.dataset.parameter ?? 'value'] = control instanceof HTMLInputElement && control.type === 'range'
          ? Number(control.value)
          : control.value;
      });
      return parameters;
    };

    const updateOutputs = () => {
      studio.querySelectorAll<HTMLInputElement>('[data-parameter][type="range"]').forEach((control) => {
        const target = studio.querySelector<HTMLOutputElement>(`[data-output="${control.id}"]`);
        if (!target) return;
        target.value = control.id === 'power-effect' ? Number(control.value).toFixed(2) : control.value;
      });
    };

    const setExperiment = (experiment: Experiment, focus = false) => {
      active = experiment;
      tabs.forEach((tab) => {
        const selected = tab.dataset.experimentTab === experiment;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      });
      panels.forEach((panel) => panel.hidden = panel.dataset.experimentPanel !== experiment);
      lastResult = null;
      copyR!.disabled = true;
      downloadButton!.disabled = true;
      summary!.innerHTML = '<p class="eyebrow">Result</p><p>Run the experiment to generate a result.</p>';
      chart!.replaceChildren();
      interpretation!.textContent = '';
      updateUrl();
    };

    const svg = (contents: string, label: string) => {
      chart!.innerHTML = `<svg viewBox="0 0 760 360" role="img" aria-label="${label}" preserveAspectRatio="xMidYMid meet">${contents}</svg>`;
    };

    const renderConfidence = (result: ConfidenceResult) => {
      const intervals = result.intervals.slice(0, 80);
      const values = intervals.flatMap((interval) => [interval.lower, interval.upper]);
      const minimum = Math.min(-0.1, ...values);
      const maximum = Math.max(0.1, ...values);
      const x = (value: number) => 70 + ((value - minimum) / (maximum - minimum)) * 650;
      const rows = intervals.map((interval, index) => {
        const y = 24 + index * (310 / Math.max(intervals.length - 1, 1));
        const colour = interval.covers ? '#214c57' : '#a53b58';
        return `<line x1="${x(interval.lower)}" y1="${y}" x2="${x(interval.upper)}" y2="${y}" stroke="${colour}" stroke-width="2"/><circle cx="${x(interval.mean)}" cy="${y}" r="2.4" fill="${colour}"/>`;
      }).join('');
      svg(`<line x1="${x(0)}" y1="15" x2="${x(0)}" y2="340" stroke="#aaa198" stroke-dasharray="4 4"/>${rows}<text x="${x(0) + 7}" y="352" fill="#6a645f" font-size="13">true mean</text>`, 'Simulated confidence intervals; intervals missing the true mean are shown in wine');
      const rate = result.covered / result.total;
      summary!.innerHTML = `<p class="eyebrow">Coverage</p><p><strong>${(rate * 100).toFixed(1)}%</strong> of ${result.total.toLocaleString()} intervals contained the true mean.</p>`;
      interpretation!.textContent = `The selected procedure is designed to capture the population mean in about ${(Number(lastParameters.confidence) * 100).toFixed(0)}% of repeated samples. Individual intervals either contain the mean or do not; the long-run proportion is the confidence level.`;
    };

    const renderHistogram = (result: SamplingResult) => {
      const values = result.means;
      const minimum = Math.min(...values);
      const maximum = Math.max(...values);
      const binCount = 28;
      const counts = Array.from({ length: binCount }, () => 0);
      values.forEach((value) => {
        const index = Math.min(binCount - 1, Math.floor(((value - minimum) / Math.max(maximum - minimum, 1e-9)) * binCount));
        counts[index] = (counts[index] ?? 0) + 1;
      });
      const maximumCount = Math.max(...counts);
      const bars = counts.map((count, index) => {
        const width = 650 / binCount;
        const height = (count / maximumCount) * 280;
        return `<rect x="${70 + index * width}" y="${320 - height}" width="${Math.max(1, width - 1)}" height="${height}" fill="#214c57"/>`;
      }).join('');
      svg(`${bars}<line x1="70" y1="320" x2="720" y2="320" stroke="#6a645f"/><text x="70" y="345" fill="#6a645f" font-size="13">${minimum.toFixed(2)}</text><text x="690" y="345" fill="#6a645f" font-size="13">${maximum.toFixed(2)}</text>`, 'Histogram of simulated sample means');
      summary!.innerHTML = `<p class="eyebrow">Sampling distribution</p><p>Mean <strong>${result.mean.toFixed(3)}</strong> · standard error <strong>${result.sd.toFixed(3)}</strong></p>`;
      interpretation!.textContent = `These are means from ${Number(lastParameters.simulations).toLocaleString()} separate samples, not the original observations. Increasing the sample size narrows their distribution; even a skewed population produces increasingly regular sample means.`;
    };

    const renderPower = (result: PowerResult) => {
      const power = result.significant / result.total;
      const critical = result.critical;
      const minimum = Math.min(-4, ...result.statistics);
      const maximum = Math.max(4, ...result.statistics);
      const binCount = 30;
      const counts = Array.from({ length: binCount }, () => 0);
      result.statistics.forEach((value) => {
        const index = Math.min(binCount - 1, Math.max(0, Math.floor(((value - minimum) / (maximum - minimum)) * binCount)));
        counts[index] = (counts[index] ?? 0) + 1;
      });
      const maximumCount = Math.max(...counts);
      const xValue = (value: number) => 70 + ((value - minimum) / (maximum - minimum)) * 650;
      const bars = counts.map((count, index) => {
        const width = 650 / binCount;
        const centre = minimum + ((index + 0.5) / binCount) * (maximum - minimum);
        const height = (count / maximumCount) * 270;
        const significant = Math.abs(centre) > critical;
        return `<rect x="${70 + index * width}" y="${320 - height}" width="${Math.max(1, width - 1)}" height="${height}" fill="${significant ? '#6e2538' : '#abc1c4'}"/>`;
      }).join('');
      svg(`${bars}<line x1="${xValue(-critical)}" y1="35" x2="${xValue(-critical)}" y2="320" stroke="#6e2538" stroke-dasharray="4 4"/><line x1="${xValue(critical)}" y1="35" x2="${xValue(critical)}" y2="320" stroke="#6e2538" stroke-dasharray="4 4"/>`, 'Distribution of simulated test statistics with rejection regions shown in wine');
      summary!.innerHTML = `<p class="eyebrow">Estimated power</p><p><strong>${(power * 100).toFixed(1)}%</strong> of simulated studies rejected the null hypothesis.</p>`;
      interpretation!.textContent = `Power is a long-run probability under the specified effect, sample size and significance threshold. It is not the probability that the alternative hypothesis is true after seeing one result.`;
    };

    const rCode = () => {
      const p = lastParameters;
      if (active === 'confidence') return `set.seed(${p.seed})\n\nn <- ${p.n}\nsimulations <- ${p.simulations}\nconfidence <- ${p.confidence}\nz <- qnorm(1 - (1 - confidence) / 2)\n\ncovered <- replicate(simulations, {\n  x <- rnorm(n)\n  interval <- mean(x) + c(-1, 1) * z * sd(x) / sqrt(n)\n  interval[1] <= 0 && interval[2] >= 0\n})\n\nmean(covered)`;
      if (active === 'sampling') {
        const generator = p.distribution === 'normal' ? 'rnorm(n)' : p.distribution === 'uniform' ? 'runif(n, -sqrt(3), sqrt(3))' : 'rexp(n) - 1';
        return `set.seed(${p.seed})\n\nn <- ${p.n}\nsimulations <- ${p.simulations}\nmeans <- replicate(simulations, mean(${generator}))\n\nhist(means, breaks = 28)\nmean(means)\nsd(means)`;
      }
      return `set.seed(${p.seed})\n\nn <- ${p.n}\neffect <- ${p.effect}\nalpha <- ${p.alpha}\nsimulations <- ${p.simulations}\n\nsignificant <- replicate(simulations, {\n  x <- rnorm(n, mean = effect, sd = 1)\n  abs(mean(x) * sqrt(n)) > qnorm(1 - alpha / 2)\n})\n\nmean(significant)`;
    };

    const resultCsv = () => {
      if (!lastResult) return '';
      if (lastResult.type === 'confidence') return ['mean,lower,upper,covers', ...lastResult.intervals.map((row) => `${row.mean},${row.lower},${row.upper},${row.covers}`)].join('\n');
      if (lastResult.type === 'sampling') return ['sample,mean', ...lastResult.means.map((value, index) => `${index + 1},${value}`)].join('\n');
      return ['simulation,test_statistic', ...lastResult.statistics.map((value, index) => `${index + 1},${value}`)].join('\n');
    };

    const updateUrl = () => {
      const parameters = currentParameters();
      const query = new URLSearchParams({ experiment: active });
      Object.entries(parameters).forEach(([key, value]) => query.set(key, String(value)));
      history.replaceState(null, '', `${window.location.pathname}?${query}`);
    };

    const run = () => {
      lastParameters = currentParameters();
      updateUrl();
      output!.setAttribute('aria-busy', 'true');
      summary!.innerHTML = '<p class="eyebrow">Running</p><p>Simulating…</p>';
      worker.postMessage({ type: active, parameters: lastParameters, token: ++runToken });
    };

    worker.addEventListener('message', ({ data }) => {
      if (data.token !== runToken) return;
      lastResult = data.result;
      output!.setAttribute('aria-busy', 'false');
      if (lastResult?.type === 'confidence') renderConfidence(lastResult);
      else if (lastResult?.type === 'sampling') renderHistogram(lastResult);
      else if (lastResult?.type === 'power') renderPower(lastResult);
      copyR!.disabled = false;
      downloadButton!.disabled = false;
    });

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => setExperiment(tab.dataset.experimentTab as Experiment));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
        event.preventDefault();
        const offset = event.key === 'ArrowRight' ? 1 : -1;
        const target = tabs[(index + offset + tabs.length) % tabs.length];
        if (target) setExperiment(target.dataset.experimentTab as Experiment, true);
      });
    });
    studio.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-parameter], [data-seed]').forEach((control) => {
      control.addEventListener('input', () => { updateOutputs(); updateUrl(); });
    });
    studio.querySelector('[data-run-simulation]')?.addEventListener('click', run);
    studio.querySelector('[data-new-seed]')?.addEventListener('click', () => {
      if (seedInput) seedInput.value = String(Math.floor(Math.random() * 2_000_000_000) + 1);
      run();
    });
    copyR?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(rCode());
      copyR.textContent = 'R code copied';
      window.setTimeout(() => copyR.textContent = 'Copy reproducible R code', 1800);
    });
    downloadButton?.addEventListener('click', () => {
      const url = URL.createObjectURL(new Blob([resultCsv()], { type: 'text/csv' }));
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.download = `${active}-simulation-${lastParameters.seed}.csv`;
      anchor.click();
      URL.revokeObjectURL(url);
    });
    studio.querySelector('[data-share-simulation]')?.addEventListener('click', async (event) => {
      updateUrl();
      await navigator.clipboard.writeText(window.location.href);
      const button = event.currentTarget as HTMLButtonElement;
      button.textContent = 'Setup link copied';
      window.setTimeout(() => button.textContent = 'Copy link to this setup', 1800);
    });

    const query = new URLSearchParams(window.location.search);
    const requested = query.get('experiment');
    if (requested && ['confidence', 'sampling', 'power'].includes(requested)) setExperiment(requested as Experiment);
    query.forEach((value, key) => {
      if (key === 'experiment') return;
      const control = key === 'seed' ? seedInput : studio.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-experiment-panel="${active}"] [data-parameter="${CSS.escape(key)}"]`);
      if (control instanceof HTMLSelectElement && ![...control.options].some((option) => option.value === value)) return;
      if (control) control.value = value;
    });
    updateOutputs();
    run();
  }
</script>
