---
import { site } from '@/data/site';

const year = new Date().getFullYear();
const footerProfiles = site.profiles.filter((profile) => profile.footer);
const primaryEmail = site.emails.at(0);
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__name">{site.name}</p>

    <nav aria-label="Academic profiles">
      <ul class="footer-links">
        {
          footerProfiles.map((profile) => (
            <li>
              <a href={profile.href} rel="me">{profile.label}</a>
            </li>
          ))
        }
        {primaryEmail && <li><a href={`mailto:${primaryEmail.address}`}>Email</a></li>}
        <li><button type="button" data-open-provenance>Site details</button></li>
      </ul>
    </nav>

    <p class="site-footer__legal">
      © {year} {site.name}. This is an independent website.
    </p>
  </div>
</footer>
