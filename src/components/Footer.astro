---
import { site } from '@/data/site';

const year = new Date().getFullYear();
const footerProfiles = site.profiles.filter((profile) => profile.footer);
const github = site.optionalProfiles.github;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__name">{site.name}</p>
      <p class="site-footer__context">Medicine, research and teaching.</p>
    </div>

    <nav aria-label="Academic profiles">
      <ul class="footer-links">
        {
          footerProfiles.map((profile) => (
            <li>
              <a href={profile.href} rel="me">{profile.label}</a>
            </li>
          ))
        }
        {github && <li><a href={github} rel="me">GitHub</a></li>}
        {site.email && <li><a href={`mailto:${site.email}`}>Email</a></li>}
      </ul>
    </nav>

    <p class="site-footer__legal">
      © {year} {site.name}. This is an independent website.
    </p>
  </div>
</footer>
