---
import { navigation, site } from '@/data/site';

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header class="site-header">
  <div class="site-header__inner container">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <span class="brand__mark" aria-hidden="true">BM</span>
      <span class="brand__name">{site.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button class="site-search" type="button" data-command-open aria-label="Search this site">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <span>Search</span>
      <kbd aria-hidden="true">/</kbd>
    </button>

    <details class="page-tools" data-page-tools>
      <summary aria-label="Open page tools">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17">
          <circle cx="5" cy="12" r="1.4"></circle>
          <circle cx="12" cy="12" r="1.4"></circle>
          <circle cx="19" cy="12" r="1.4"></circle>
        </svg>
        <span>Tools</span>
      </summary>
      <div class="page-tools__menu">
        <p>Page tools</p>
        <button type="button" data-copy-page-link>Copy page link</button>
        <button type="button" data-share-page>Share this page</button>
        <button type="button" data-copy-citation hidden>Copy APA citation</button>
        <button type="button" data-save-resource hidden aria-pressed="false">Save resource</button>
        <button type="button" data-print-page>Print or save as PDF</button>
      </div>
    </details>

    <details class="mobile-nav">
      <summary>
        <span>Menu</span>
        <span class="mobile-nav__glyph" aria-hidden="true"></span>
      </summary>
      <nav aria-label="Primary navigation">
        <ul>
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
