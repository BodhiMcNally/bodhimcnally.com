---
const cases = [
  { id: 'coefficient', label: 'Linear coefficient', prompt: 'A model estimates a coefficient of −3.4 mmHg (95% CI −5.8 to −1.0) for treatment versus control.', choices: ['The treatment causes everyone’s blood pressure to fall by 3.4 mmHg.', 'The treatment group had an estimated mean outcome 3.4 mmHg lower than control, conditional on the model covariates.', 'There is a 95% probability that the true effect is between −5.8 and −1.0.'], answer: 1, feedback: 'Interpret the comparison, units and adjustment set. Avoid individual-level or causal language unless the design and assumptions support it.' },
  { id: 'odds', label: 'Odds ratio', prompt: 'Adjusted OR 1.60 (95% CI 1.12–2.29) for postoperative complication among exposed versus unexposed patients.', choices: ['The exposed group has a 60 percentage-point higher risk.', 'The odds of complication are estimated to be 60% higher in the exposed group, conditional on included covariates.', '60% of exposed patients experienced a complication.'], answer: 1, feedback: 'An odds ratio is a ratio of odds, not risks or percentage points. When outcomes are common, ORs can look further from 1 than risk ratios.' },
  { id: 'interaction', label: 'Interaction', prompt: 'The treatment-by-sex interaction coefficient is positive and its 95% CI excludes zero.', choices: ['Treatment works only in one sex.', 'The estimated treatment association differs between sex groups on the model’s specified scale.', 'Sex is a confounder.'], answer: 1, feedback: 'An interaction concerns effect heterogeneity on a chosen scale. It does not by itself establish effectiveness in either subgroup or identify confounding.' },
  { id: 'pvalue', label: 'P-value', prompt: 'A prespecified comparison gives p = 0.03.', choices: ['There is a 3% probability that the null hypothesis is true.', 'If the null model and assumptions held, results at least this incompatible with it would occur about 3% of the time.', 'There is a 97% probability that the result will replicate.'], answer: 1, feedback: 'A p-value is conditional on the null model and analysis assumptions. It is not a posterior probability, effect size or replication probability.' },
];
---
<section class="academic-tool clinic" data-clinic aria-labelledby="clinic-title">
  <header class="tool-intro"><div><p class="eyebrow">Practice with feedback</p><h2 id="clinic-title">Statistical interpretation clinic</h2></div><p>Choose the most defensible interpretation, then examine why the alternatives fail.</p></header>
  <div class="clinic-progress"><span data-clinic-progress>Case 1 of {cases.length}</span><progress value="1" max={cases.length} data-clinic-progressbar></progress></div>
  <article class="clinic-case" data-clinic-case><p class="eyebrow" data-clinic-label></p><h3 data-clinic-prompt></h3><div data-clinic-choices></div><div class="clinic-feedback" data-clinic-feedback hidden></div></article>
  <div class="tool-actions"><button type="button" data-clinic-prev>Previous</button><button type="button" data-clinic-next>Next case</button><button type="button" data-clinic-reset>Reset progress</button></div>
  <script is:inline type="application/json" data-clinic-data set:html={JSON.stringify(cases)}></script>
</section>
<script>
  type ClinicCase={id:string;label:string;prompt:string;choices:string[];answer:number;feedback:string}; const root=document.querySelector<HTMLElement>('[data-clinic]');
  if(root){const cases=JSON.parse(root.querySelector('[data-clinic-data]')?.textContent??'[]') as ClinicCase[];let index=0;let answers:Record<string,number>={};try{answers=JSON.parse(localStorage.getItem('bm-clinic-v1')??'{}');}catch{}
    const render=()=>{const item=cases[index];if(!item)return;root.querySelector<HTMLElement>('[data-clinic-label]')!.textContent=item.label;root.querySelector<HTMLElement>('[data-clinic-prompt]')!.textContent=item.prompt;root.querySelector<HTMLElement>('[data-clinic-progress]')!.textContent=`Case ${index+1} of ${cases.length} · ${Object.keys(answers).length} completed`;root.querySelector<HTMLProgressElement>('[data-clinic-progressbar]')!.value=index+1;const choices=root.querySelector<HTMLElement>('[data-clinic-choices]')!;choices.replaceChildren(...item.choices.map((choice,choiceIndex)=>{const button=document.createElement('button');button.type='button';button.textContent=choice;if(answers[item.id]!==undefined){button.dataset.selected=String(answers[item.id]===choiceIndex);button.dataset.correct=String(choiceIndex===item.answer);button.disabled=true;}button.addEventListener('click',()=>{answers[item.id]=choiceIndex;localStorage.setItem('bm-clinic-v1',JSON.stringify(answers));render();});return button;}));const feedback=root.querySelector<HTMLElement>('[data-clinic-feedback]')!;const selected=answers[item.id];feedback.hidden=selected===undefined;feedback.textContent=selected===undefined?'':`${selected===item.answer?'Correct.':'Not quite.'} ${item.feedback}`;};
    root.querySelector('[data-clinic-prev]')?.addEventListener('click',()=>{index=(index-1+cases.length)%cases.length;render();});root.querySelector('[data-clinic-next]')?.addEventListener('click',()=>{index=(index+1)%cases.length;render();});root.querySelector('[data-clinic-reset]')?.addEventListener('click',()=>{answers={};localStorage.removeItem('bm-clinic-v1');render();});render();}
</script>
