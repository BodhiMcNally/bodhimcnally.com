<section class="academic-tool viz-critique" data-viz-critique aria-labelledby="viz-title">
  <header class="tool-intro"><div><p class="eyebrow">Figure clinic</p><h2 id="viz-title">Data visualisation critique studio</h2></div><p>Repair a deliberately weak figure and watch the corresponding ggplot2 decisions appear.</p></header>
  <div class="tool-grid"><form class="tool-controls"><label><input type="checkbox" data-viz="zero"> Begin the bar axis at zero</label><label><input type="checkbox" data-viz="order"> Order groups by value</label><label><input type="checkbox" data-viz="direct"> Label values directly</label><label><input type="checkbox" data-viz="accessible"> Use an accessible palette</label><label><input type="checkbox" data-viz="uncertainty"> Show uncertainty intervals</label><label><input type="checkbox" data-viz="title"> Write a specific title</label></form><div class="tool-output"><div class="tool-figure" data-viz-figure></div><div class="viz-score"><span data-viz-score>0</span><p data-viz-message></p></div><pre><code data-viz-code></code></pre></div></div>
</section>
<script>
  const root=document.querySelector<HTMLElement>('[data-viz-critique]');if(root){const original=[{g:'A',v:74,e:4},{g:'B',v:68,e:5},{g:'C',v:81,e:3},{g:'D',v:72,e:6}];const checked=(name:string)=>root.querySelector<HTMLInputElement>(`[data-viz="${name}"]`)?.checked??false;const update=()=>{const data=checked('order')?[...original].sort((a,b)=>a.v-b.v):original;const min=checked('zero')?0:60,max=90;const y=(v:number)=>270-((v-min)/(max-min))*210;const colours=checked('accessible')?['#214c57','#6e2538','#8b6f47','#527b82']:['#f04e98','#2fe5e5','#ecff33','#9f4bff'];const bars=data.map((d,i)=>`<rect x="${95+i*135}" y="${y(d.v)}" width="75" height="${270-y(d.v)}" fill="${colours[i]}"/>${checked('uncertainty')?`<line x1="${132+i*135}" y1="${y(d.v-d.e)}" x2="${132+i*135}" y2="${y(d.v+d.e)}" stroke="#1c1918" stroke-width="3"/>`:''}${checked('direct')?`<text x="${132+i*135}" y="${y(d.v)-10}" text-anchor="middle">${d.v}%</text>`:''}<text x="${132+i*135}" y="295" text-anchor="middle">${d.g}</text>`).join('');root.querySelector<HTMLElement>('[data-viz-figure]')!.innerHTML=`<svg viewBox="0 0 720 330" role="img" aria-label="Bar chart being improved"><text x="360" y="26" text-anchor="middle" font-size="19" font-weight="700">${checked('title')?'Completion differed across study groups':'Results'}</text><line x1="70" y1="270" x2="670" y2="270" stroke="#6a645f"/>${bars}</svg>`;const score=root.querySelectorAll<HTMLInputElement>('[data-viz]:checked').length;root.querySelector('[data-viz-score]')!.textContent=`${score}/6`;root.querySelector('[data-viz-message]')!.textContent=score<3?'The chart still makes comparison unnecessarily difficult.':score<6?'Much clearer. Consider what uncertainty and wording the reader still needs.':'The repaired chart is more honest, interpretable and accessible.';const code=[`ggplot(results, aes(x = group, y = percentage)) +`,`  geom_col(aes(fill = group)) +`,checked('uncertainty')?`  geom_errorbar(aes(ymin = lower, ymax = upper), width = 0.15) +`:null,checked('direct')?`  geom_text(aes(label = scales::percent(percentage / 100)), vjust = -0.5) +`:null,checked('order')?`  scale_x_discrete(limits = results$group[order(results$percentage)]) +`:null,checked('zero')?`  scale_y_continuous(limits = c(0, NA)) +`:null,checked('accessible')?`  scale_fill_manual(values = c("#214c57", "#6e2538", "#8b6f47", "#527b82")) +`:null,checked('title')?`  labs(title = "Completion differed across study groups", x = NULL, y = "Completion (%)") +`:null,`  theme_minimal()`].filter(Boolean).join('\n');root.querySelector('[data-viz-code]')!.textContent=code;};root.addEventListener('change',update);update();}
</script>
